class Shape { Shape(n) { this.n = n; } area() { return 0; } name() { return "shape"; } describe() { print(this.name(), this.area()); } }
class Sq extends Shape { Sq(s) { this.n = "sq"; this.s = s; } area() { return this.s * this.s; } name() { return "square"; } }
class Circle { Circle(r) { this.r = r; } area() { return 3.0 * this.r * this.r; } }
extend on Circle { fn grow(k) { this.r = this.r + k; return this.r; } }
let shapes = [new Shape("x"), new Sq(3)];
for s in shapes { s.describe(); print(s.area()); }
let c = new Circle(2.0);
print(c.area());
print(c.grow(1.0));
print(c.area());
fn total(a, b) { return a.area() + b.area(); }
print(total(new Sq(2), new Sq(3)));
