# Runtime image based on Ubuntu 24.04 that installs a verified AdeshLang .deb.
#
# Pass the exact package URL and its SHA-256 at build time. The previous
# version downloaded a hardcoded unsigned .deb and ran as root with no
# integrity check — that is refused here.
#
# Example:
#   docker build -f Dockerfile.release \
#     --build-arg ADESH_DEB_URL=https://github.com/adeshlang/adeshlang/releases/download/v0.3.0/adeshlang_0.3.0_amd64.deb \
#     --build-arg ADESH_DEB_SHA256=<sha256> \
#     -t adeshlang:release .

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/usr/lib/adeshlang/bin:${PATH}"
ENV ADESH_HOME="/usr/lib/adeshlang"

ARG TARGETARCH
ARG ADESH_DEB_URL
ARG ADESH_DEB_SHA256

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        build-essential \
        clang \
        lld \
        llvm \
        llvm-dev \
        libclang-dev \
        mlir-18-tools \
        git \
        nano \
        procps && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    if [ -z "${ADESH_DEB_URL:-}" ] || [ -z "${ADESH_DEB_SHA256:-}" ]; then \
      echo "ADESH_DEB_URL and ADESH_DEB_SHA256 build-args are required" >&2; \
      exit 1; \
    fi; \
    curl -fsSL -o /tmp/adeshlang.deb "${ADESH_DEB_URL}"; \
    echo "${ADESH_DEB_SHA256}  /tmp/adeshlang.deb" | sha256sum -c -; \
    dpkg -i /tmp/adeshlang.deb; \
    rm -f /tmp/adeshlang.deb

RUN groupadd -g 1000 adesh && \
    useradd -u 1000 -g adesh -m -s /bin/bash adesh && \
    mkdir -p /workspace && \
    chown -R adesh:adesh /workspace

WORKDIR /workspace
USER adesh

CMD ["/bin/bash"]
