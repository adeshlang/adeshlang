FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/usr/lib/adeshlang/bin:${PATH}"
ENV ADESH_HOME="/usr/lib/adeshlang"

# Install core runtime utilities, build tools, and complete LLVM/Clang/LLD/MLIR toolchain
ARG TARGETARCH
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        build-essential \
        clang \
        lld \
        llvm \
        llvm-dev \
        libclang-dev \
        mlir-18-tools \
        git \
        nano \
        procps && \
    DEB_ARCH="amd64" && \
    if [ "$TARGETARCH" = "arm64" ]; then DEB_ARCH="arm64"; fi && \
    curl -sLO "https://github.com/adeshlang/adeshlang/releases/download/v0.3.0/adeshlang_0.3.0_${DEB_ARCH}.deb" && \
    dpkg -i "adeshlang_0.3.0_${DEB_ARCH}.deb" && \
    rm "adeshlang_0.3.0_${DEB_ARCH}.deb" && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["/bin/bash"]

