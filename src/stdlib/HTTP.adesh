    return HTTP.SecurityHeaders();
}

/// CSRF protection middleware helper.
export fn CSRF() {
    return HTTP.CSRF();
}

/// Authentication middleware helper.
export fn Auth(opts) {
    return HTTP.Auth(opts);
}

/// Role-based authorization middleware helper.
export fn requireRole(role: string) {
    return HTTP.requireRole(role);
}

/// Rate limiting middleware helper.
export fn RateLimit(opts) {
