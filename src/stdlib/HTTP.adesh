}

/// Create a WebSocket connection/server helper.
export fn WebSocket() {
    return HTTP.WebSocket();
}

/// Create a WebSocket broadcast room.
export fn WebSocketRoom(name: string) {
    return HTTP.WebSocketRoom(name);
}

/// SSE event emitter helper.
export fn SSE() {
    return HTTP.SSE();
}

/// API Gateway router & proxy abstraction.
export fn Gateway() {
