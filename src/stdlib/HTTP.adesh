}

/// Client mocking utility for unit testing.
export fn MockClient() {
    return HTTP.MockClient();
}

/// Report security posture of a target URL.
export fn securityPosture(url: string) {
    return HTTP.securityPosture(url);
}

/// Discover HTTP capabilities of a target URL.
export fn discover(url: string) {
    return HTTP.discover(url);
}

