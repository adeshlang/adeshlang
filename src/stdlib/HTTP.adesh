}

/// Problem details generator (RFC 7807 application/problem+json).
export fn Problem(status: int, title: string, detail: string) {
    return HTTP.Problem(status, title, detail);
}

/// In-memory testing client (no TCP socket required).
export fn TestClient(app) {
