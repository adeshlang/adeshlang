// Production-Grade Env Standard Library for AdeshLang
import Path;

export class Env {
    Env() {}

    // ------------------------------------------------------------------
    // Environment Variables
    // ------------------------------------------------------------------

    static fn get(key: string): string {
        return envGet(key, null);
    }
    static fn getOrDefault(key: string, default_val = null): string {
        return envGet(key, default_val);
    }
    static fn set(key: string, value: string) {
        envSet(key, value);
    }
    static fn setIfAbsent(key: string, value: string): boolean {
        return envSetIfAbsent(key, value);
    }
    static fn remove(key: string) {
        envRemove(key);
    }
    static fn unset(key: string) {
        envRemove(key);
    }
    static fn contains(key: string): boolean {
        return envHas(key);
    }
    static fn has(key: string): boolean {
        return envHas(key);
    }
    static fn exists(key: string): boolean {
        return envHas(key);
    }
    static fn clear() {
        envClear();
    }
    static fn variables(): object {
        return envAll();
    }
    static fn environ(): object {
        return envAll();
    }
    static fn toObject(): object {
        return envAll();
    }
    static fn keys(): array {
        let vars = envAll();
        let k_list = [];
        for k in vars {
            k_list.push(k);
        }
        return k_list;
    }
    static fn values(): array {
        let vars = envAll();
        let v_list = [];
        for k in vars {
            v_list.push(vars[k]);
        }
        return v_list;
    }
    static fn count(): int {
        return envCount();
    }
    static fn getMany(keys: array): object {
        return envGetMany(keys);
    }
    static fn filter(prefix: string): object {
        return envFilter(prefix);
    }
    static fn filterKeys(prefix: string): array {
        let vars = envFilter(prefix);
        let k_list = [];
        for k in vars {
            k_list.push(k);
        }
        return k_list;
    }

    // .env file support
    static fn fromFile(path = ".env"): object {
        return envFromFile(path);
    }
    static fn getFromFile(key: string, default_val = null, path = ".env"): string {
        return envFileGet(key, default_val, path);
    }
    static fn load(path = ".env", overwrite = false): int {
        return envRuntimeLoad(path, overwrite);
    }
    static fn loadFromFile(path = ".env", overwrite = false): int {
        return envRuntimeLoad(path, overwrite);
    }
    static fn runtimeVariables(): object {
        return envRuntimeAll();
    }
    static fn runtimeGet(key: string): string {
        return envRuntimeGet(key);
    }
    static fn runtimeHas(key: string): boolean {
        return envRuntimeHas(key);
    }
    static fn runtimeLoad(objectOrPath, overwrite = false): int {
        return envRuntimeLoad(objectOrPath, overwrite);
    }

    // ------------------------------------------------------------------
    // Directories
    // ------------------------------------------------------------------

    static fn currentDirectory(): Path {
        let p = path_current();
        return new Path(p);
    }
    static fn currentDir(): Path {
        return Env.currentDirectory();
    }
    static fn setCurrentDirectory(path_val) {
        let p_str = typeof(path_val) == "string" ? path_val : path_val.toString();
        return envSetCurrentDir(p_str);
    }
    static fn home(): Path {
        let p = envUserDir("home");
        return Path.new(p);
    }
    static fn desktop(): Path {
        let p = envUserDir("desktop");
        return Path.new(p);
    }
    static fn documents(): Path {
        let p = envUserDir("documents");
        return Path.new(p);
    }
    static fn downloads(): Path {
        let p = envUserDir("downloads");
        return Path.new(p);
    }
    static fn pictures(): Path {
        let p = envUserDir("pictures");
        return Path.new(p);
    }
    static fn music(): Path {
        let p = envUserDir("music");
        return Path.new(p);
    }
    static fn videos(): Path {
        let p = envUserDir("videos");
        return Path.new(p);
    }
    static fn public(): Path {
        let p = envUserDir("public");
        return Path.new(p);
    }
    static fn tempDirectory(): Path {
        let p = envUserDir("temp");
        return Path.new(p);
    }
    static fn userCacheDirectory(): Path {
        let p = envSystemInfo().userCache;
        return Path.new(p);
    }
    static fn userConfigDirectory(): Path {
        let p = envSystemInfo().userConfig;
        return Path.new(p);
    }

    // ------------------------------------------------------------------
    // Executable
    // ------------------------------------------------------------------

    static fn executable(): Path {
        let p = envUserDir("exe");
        return Path.new(p);
    }
    static fn executableDirectory(): Path {
        let p = envUserDir("exedir");
        return Path.new(p);
    }
    static fn executableName(): string {
        return execName();
    }

    // ------------------------------------------------------------------
    // Platform & Metadata
    // ------------------------------------------------------------------

    static fn os(): string {
        let info = envPlatformInfo();
        return info.os;
    }
    static fn architecture(): string {
        let info = envPlatformInfo();
        return info.arch;
    }
    static fn arch(): string {
        let info = envPlatformInfo();
        return info.arch;
    }
    static fn platform(): string {
        let info = envPlatformInfo();
        return info.platform;
    }
    static fn hostname(): string {
        let info = envPlatformInfo();
        return info.hostname;
    }
    static fn username(): string {
        let info = envPlatformInfo();
        return info.username;
    }
    static fn userId(): string {
        let info = envPlatformInfo();
        return info.userId;
    }
    static fn processId(): int {
        let info = envPlatformInfo();
        return info.pid;
    }
    static fn osType(): string {
        return envSystemInfo().osType;
    }
    static fn osVersion(): string {
        return envSystemInfo().osVersion;
    }
    static fn osFamily(): string {
        return envSystemInfo().osFamily;
    }
    static fn osRelease(): string {
        return envSystemInfo().osRelease;
    }
    static fn osDescription(): string {
        return envSystemInfo().osDescription;
    }
    static fn cpuCount(): int {
        return envSystemInfo().cpuCount;
    }
    static fn totalMemory(): int {
        return envSystemInfo().totalMemory;
    }
    static fn freeMemory(): int {
        return envSystemInfo().freeMemory;
    }
    static fn usedMemory(): int {
        let info = envSystemInfo();
        return info.totalMemory - info.freeMemory;
    }
    static fn memoryUsage(): object {
        let info = envSystemInfo();
        let used = info.totalMemory - info.freeMemory;
        let out = {};
        out.total = info.totalMemory;
        out.free = info.freeMemory;
        out.used = used;
        out.percent = info.totalMemory > 0 ? (used * 100.0 / info.totalMemory) : 0.0;
        return out;
    }
    static fn uptime(): int {
        return envSystemInfo().processUptime;
    }
    static fn systemUptime(): int {
        return envSystemInfo().systemUptime;
    }
    static fn loadAverage(): array {
        return envSystemInfo().loadavg;
    }
    static fn endianness(): string {
        return envSystemInfo().endianness;
    }
    static fn parentProcessId(): int {
        return envSystemInfo().ppid;
    }

    // Shell
    static fn shell(): string {
        let info = envPlatformInfo();
        return info.shell;
    }
    static fn processTitle(): string {
        return envSystemInfo().processTitle;
    }
    static fn pagesize(): int {
        return envSystemInfo().pagesize;
    }
    static fn machineId(): string {
        return envSystemInfo().machineId;
    }
    static fn userInfo(): object {
        return envUserInfo();
    }
    static fn systemInfo(): object {
        return envSystemInfo();
    }
    static fn commandLine(): string {
        return envCommandLine();
    }

    // ------------------------------------------------------------------
    // Platform Predicates
    // ------------------------------------------------------------------

    static fn isWindows(): boolean {
        let info = envPlatformInfo();
        return info.os == "windows";
    }
    static fn isLinux(): boolean {
        let info = envPlatformInfo();
        return info.os == "linux";
    }
    static fn isMacOS(): boolean {
        let info = envPlatformInfo();
        return info.os == "macos";
    }
    static fn isMacos(): boolean {
        return Env.isMacOS();
    }
    static fn isWasm(): boolean {
        let info = envPlatformInfo();
        return info.os == "wasm";
    }
    static fn isUnix(): boolean {
        return !Env.isWindows() && !Env.isWasm();
    }

    // ------------------------------------------------------------------
    // Runtime & Separators
    // ------------------------------------------------------------------

    static fn languageVersion(): string {
        return "1.0.0";
    }
    static fn compilerVersion(): string {
        return "1.0.0";
    }
    static fn runtimeVersion(): string {
        return "1.0.0";
    }
    static fn version(): object {
        let out = {};
        out.language = Env.languageVersion();
        out.compiler = Env.compilerVersion();
        out.runtime = Env.runtimeVersion();
        return out;
    }
    static fn pathSeparator(): string {
        let is_win = path_is_windows();
        if (is_win) {
            return ";";
        }
        return ":";
    }
    static fn pathListSeparator(): string {
        return Env.pathSeparator();
    }
    static fn fileSeparator(): string {
        return path_sep();
    }
    static fn lineSeparator(): string {
        let is_win = path_is_windows();
        if (is_win) {
            return "\r\n";
        }
        return "\n";
    }
    static fn eol(): string {
        return Env.lineSeparator();
    }

    // ------------------------------------------------------------------
    // Command Line
    // ------------------------------------------------------------------

    static fn arguments(): array {
        return args();
    }
    static fn args(): array {
        return Env.arguments();
    }
    static fn argumentCount(): int {
        return argsCount();
    }
    static fn arg(index: int) {
        let a = args();
        if (index >= 0 && index < len(a)) {
            return a[index];
        }
        return null;
    }
    static fn argsSlice(start: int): array {
        let a = args();
        let out = [];
        let i = start;
        while (i < len(a)) {
            out.push(a[i]);
            i = i + 1;
        }
        return out;
    }
    static fn argsJoin(sep = " "): string {
        let a = args();
        let s = "";
        let i = 0;
        while (i < len(a)) {
            if (i > 0) {
                s = s + sep;
            }
            s = s + a[i];
            i = i + 1;
        }
        return s;
    }
    static fn argsIndexOf(value: string): int {
        let a = args();
        let i = 0;
        while (i < len(a)) {
            if (a[i] == value) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
    static fn parseArgs(): object {
        return Env._parseArgs();
    }
    static fn argGet(name: string, default_val = null) {
        return Env._argGet(name, default_val);
    }
    static fn argHas(name: string): boolean {
        return Env._argHas(name);
    }
    static fn _parseArgs(): object {
        return parseArgs();
    }
    static fn _argGet(name: string, default_val = null) {
        return argGet(name, default_val);
    }
    static fn _argHas(name: string): boolean {
        return argHas(name);
    }

    // ------------------------------------------------------------------
    // Aliases (bare builtin parity)
    // ------------------------------------------------------------------

    static fn argc(): int {
        return Env._argc();
    }
    static fn _argc(): int {
        return argc();
    }
    static fn argv(): array {
        return Env._argv();
    }
    static fn _argv(): array {
        return argv();
    }
    static fn argsCount(): int {
        return Env._argsCount();
    }
    static fn _argsCount(): int {
        return argsCount();
    }
    static fn execName(): string {
        return Env._execName();
    }
    static fn _execName(): string {
        return execName();
    }
    static fn env(key: string, default_val = null) {
        let v = Env._env(key);
        if (v == null) {
            return default_val;
        }
        return v;
    }
    static fn _env(key: string) {
        return env(key);
    }
    static fn envFromFile(path = ".env"): object {
        return Env._envFromFile(path);
    }
    static fn _envFromFile(path = ".env"): object {
        return envFromFile(path);
    }
    static fn envFileGet(key: string, default_val = null, path = ".env") {
        return Env._envFileGet(key, default_val, path);
    }
    static fn _envFileGet(key: string, default_val = null, path = ".env") {
        return envFileGet(key, default_val, path);
    }
    static fn envRuntimeLoad(objectOrPath, overwrite = false): int {
        return Env._envRuntimeLoad(objectOrPath, overwrite);
    }
    static fn _envRuntimeLoad(objectOrPath, overwrite = false): int {
        return envRuntimeLoad(objectOrPath, overwrite);
    }
    static fn envRuntimeGet(key: string) {
        return Env._envRuntimeGet(key);
    }
    static fn _envRuntimeGet(key: string) {
        return envRuntimeGet(key);
    }
    static fn envRuntimeHas(key: string): boolean {
        return Env._envRuntimeHas(key);
    }
    static fn _envRuntimeHas(key: string): boolean {
        return envRuntimeHas(key);
    }
    static fn envRuntimeAll(): object {
        return Env._envRuntimeAll();
    }
    static fn _envRuntimeAll(): object {
        return envRuntimeAll();
    }
}
