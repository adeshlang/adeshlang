# AI: keep the training/training-data machinery out of the repository, but
# track the deployment surface so CI and installers can bundle the model:
# ai/models/manifest.json (model URLs + SHA-256) and ai/deploy/ (Ollama
# Modelfile, vLLM/llama.cpp/OpenRouter server configs).
ai/models/*
!ai/models/manifest.json
!ai/models/.gitkeep
ai/data/*
!ai/data/.gitkeep
ai/datasets/*
!ai/datasets/.gitkeep
ai/dataset/*
ai/knowledge/*
!ai/knowledge/.gitkeep
ai/src/
ai/training/
ai/inference/
ai/scripts/
ai/tests/
ai/evaluation/
ai/configs/
ai/notebooks/
ai/llama_cpp_repo/


