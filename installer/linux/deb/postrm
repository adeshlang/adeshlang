#!/bin/sh
set -eu

prefix="/usr/lib/adeshlang"

case "$1" in
    remove)
        for binary in adesh adl als adesh-editor; do
            link="/usr/bin/$binary"
            if [ -L "$link" ] && [ "$(readlink "$link")" = "$prefix/bin/$binary" ]; then
                rm -f "$link"
            fi
        done
        rm -f /etc/profile.d/adeshlang.sh
        # Keep the package's other files under dpkg's control, but remove the
        # downloaded toolchain which is generated by postinst.
        rm -rf "$prefix/toolchain"
        ;;
esac

exit 0
