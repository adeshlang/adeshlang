#!/bin/sh
set -eu

prefix="/usr/lib/adeshlang"

case "$1" in
    remove)
        for binary in adesh adl als adesh-editor adeshlink; do
            link="/usr/bin/$binary"
            if [ -L "$link" ] && [ "$(readlink "$link")" = "$prefix/bin/$binary" ]; then
                rm -f "$link"
            fi
        done
        rm -f /etc/profile.d/adeshlang.sh
        # {prefix}/toolchain only exists when the user registered an external
        # LLVM bridge there (`adesh toolchain --external install`); the native
        # toolchain ships inside the package itself.
        rm -rf "$prefix/toolchain"
        ;;
esac

exit 0
