#!/bin/sh
set -eu

prefix="/usr/lib/adeshlang"
profile="/etc/profile.d/adeshlang.sh"

if [ "$1" = "configure" ]; then
    for binary in adesh adl als adesh-editor; do
        if [ -x "$prefix/bin/$binary" ]; then
            ln -sfn "$prefix/bin/$binary" "/usr/bin/$binary"
        fi
    done

    mkdir -p "$(dirname "$profile")"
    cat > "$profile" <<'PROFILE'
# AdeshLang environment (managed by the adeshlang package)
export ADESH_HOME="/usr/lib/adeshlang"
export ADESH_TOOLCHAIN="/usr/lib/adeshlang/toolchain/llvm"
export ADESH_CLANG="/usr/lib/adeshlang/toolchain/llvm/bin/clang"
export ADESH_LLC="/usr/lib/adeshlang/toolchain/llvm/bin/llc"
export ADESH_MLIR_OPT="/usr/lib/adeshlang/toolchain/llvm/bin/mlir-opt"
export ADESH_MLIR_TRANSLATE="/usr/lib/adeshlang/toolchain/llvm/bin/mlir-translate"
export PATH="/usr/lib/adeshlang/bin:$PATH"
PROFILE

    if [ "${ADESH_DEB_INSTALL_TOOLCHAIN:-0}" = "1" ]; then
        if [ "${ADESH_DEB_USE_SYSTEM_PACKAGES:-${ADESH_USE_SYSTEM_PACKAGES:-0}}" = "1" ]; then
            ADESH_HOME="$prefix" "$prefix/bin/adesh" toolchain install --system --use-system-packages
        else
            ADESH_HOME="$prefix" "$prefix/bin/adesh" toolchain install --system
        fi
    else
        echo "AdeshLang toolchain not installed by default."
        echo "To install it, run: sudo ADESH_HOME=$prefix $prefix/bin/adesh toolchain install --system"
        echo "For distro packages, append: --use-system-packages"
    fi
fi

exit 0
