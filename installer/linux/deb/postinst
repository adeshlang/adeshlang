#!/bin/sh
set -eu

prefix="/usr/lib/adeshlang"
profile="/etc/profile.d/adeshlang.sh"

if [ "$1" = "configure" ]; then
    for binary in adesh adl als adesh-editor adeshlink; do
        if [ -x "$prefix/bin/$binary" ]; then
            ln -sfn "$prefix/bin/$binary" "/usr/bin/$binary"
        fi
    done

    mkdir -p "$(dirname "$profile")"
    # The Adesh native toolchain (codegen + adeshlink linker + ADOB + runtime)
    # ships inside the package: no toolchain variables are exported and no
    # LLVM/MSVC install is needed. Users who opt into the external LLVM
    # bridge register it separately with `adesh toolchain --external install`.
    cat > "$profile" <<'PROFILE'
# AdeshLang environment (managed by the adeshlang package)
export ADESH_HOME="/usr/lib/adeshlang"
export ADESH_STD="/usr/lib/adeshlang/std"
case ":$PATH:" in
  *":/usr/lib/adeshlang/bin:"*) ;;
  *) export PATH="/usr/lib/adeshlang/bin:$PATH" ;;
esac
PROFILE

    if [ ! -f "$prefix/ai/models/adesh-coder-0.5b-q4_0.gguf" ]; then
        echo "Note: AI neural models are not bundled in this package."
        echo "To download and set up the default local AI coder model (~275 MB), run: adesh ai setup"
    fi

    # Self-verify the bundled native toolchain (fast; no downloads).
    if [ -x "$prefix/bin/adesh" ]; then
        ADESH_HOME="$prefix" "$prefix/bin/adesh" toolchain check || true
    fi
fi

exit 0
