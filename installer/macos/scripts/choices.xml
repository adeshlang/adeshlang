<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
  AdeshLang product Distribution (used by productbuild).

  A single core choice: the Adesh native toolchain (native codegen, ADOB
  object format, adeshlink linker, adeshlang runtime library, stdlib) ships
  inside the core payload, so there is no separate toolchain package and
  nothing is downloaded during installation. The choice is hidden and always
  selected: the user cannot deselect the compiler itself.

  External LLVM remains an opt-in bridge the user registers after install:
    adesh gpu-check --external-linker
    adesh toolchain --external install

  Build (see build-pkg.sh, which does all of this):
    - core component: pkgbuild run on the staged payload (bin, lib, std,
      config, licenses, ai) with the core scripts folder, the identifier
      org.adeshlang.pkg.core, the install-location
      "/Library/Application Support/AdeshLang" and min OS 12 -> core.pkg
    - product archive: productbuild run with this Distribution, the package
      path set to the folder holding core.pkg, and an optional signing
      identity -> AdeshLang-0.3.0-<arch>-macos.pkg

  Identifiers are reverse-DNS: org.adeshlang.pkg.core.
-->
<installer-gui-script minSpecVersion="1">
    <title>AdeshLang</title>
    <organization>org.adeshlang</organization>
    <domains enable_localSystem="true"/>
    <options customize="allow" require-scripts="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="12.0"/>
        </allowed-os-versions>
    </volume-check>

    <pkg-ref id="org.adeshlang.pkg.core" version="0.3.0">core.pkg</pkg-ref>

    <choices-outline>
        <line choice="core"/>
    </choices-outline>

    <choice id="core"
            title="AdeshLang 0.3.0 - compiler, package manager, LSP, editor"
            description="Installs AdeshLang with its bundled self-contained native toolchain (native codegen, ADOB object format, adeshlink linker, adeshlang runtime) to /Library/Application Support/AdeshLang and links adesh, adl, als, adeshlink and adesh-editor into /usr/local/bin. No external LLVM or MSVC is downloaded or required. Required - cannot be deselected."
            visible="false" start_selected="true">
        <pkg-ref id="org.adeshlang.pkg.core"/>
    </choice>
</installer-gui-script>
