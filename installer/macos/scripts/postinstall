#!/usr/bin/env bash
# AdeshLang core component postinstall (productbuild / pkgbuild).
#
# Runs as root after the core payload (bin/, lib/, std/, config/, licenses/)
# lands at /Library/Application Support/AdeshLang. Standard pkg scripts
# receive: $1 = package path, $2 = install location, $3 = target volume.
#
# The Adesh native toolchain (native codegen, ADOB object format, adeshlink
# linker, adeshlang runtime library) ships inside the payload: nothing is
# downloaded during installation and no external LLVM/Clang/MSVC is required.
# External LLVM remains an opt-in bridge the user can register afterwards
# with `adesh toolchain --external install`.
#
# Steps:
#   1. Verify we are root (postinstalls run as root; guard anyway).
#   2. Symlink the AdeshLang CLI tools (adesh, adl, als, adeshlink,
#      adesh-editor) into /usr/local/bin.
#   3. Write /etc/profile.d/adeshlang.sh exporting ADESH_HOME/ADESH_STD/PATH.
#   4. Self-verify the bundled native toolchain (fast, offline).
set -euo pipefail

# $2 is the payload's install location when the product installer runs us
# ("<target-volume>/Library/Application Support/AdeshLang"). Fall back to the
# known location if we are ever invoked outside a product install.
if [[ -n "${2:-}" && "$2" != "/" ]]; then
    HOME_DIR="$2"
else
    HOME_DIR="/Library/Application Support/AdeshLang"
fi
BIN_DIR="$HOME_DIR/bin"
LINK_DIR="/usr/local/bin"
PROFILE_FILE="/etc/profile.d/adeshlang.sh"

# 1. Root check ---------------------------------------------------------------
if [[ "$(id -u)" -ne 0 ]]; then
    echo "AdeshLang postinstall must run as root; aborting." >&2
    exit 1
fi

# 2. Symlink the CLI tools into /usr/local/bin (idempotent) --------------------
mkdir -p "$LINK_DIR"
for tool in adesh adl als adeshlink adesh-editor; do
    if [[ -x "$BIN_DIR/$tool" ]]; then
        ln -sfn "$BIN_DIR/$tool" "$LINK_DIR/$tool"
        echo "AdeshLang: linked $LINK_DIR/$tool"
    else
        echo "AdeshLang: note — $tool not present in $BIN_DIR; skipping symlink"
    fi
done

# 3. Shell profile -------------------------------------------------------------
# macOS login shells pick this up where /etc/profile.d is sourced (bash and
# zsh on most macOS setups read it via /etc/profile / /etc/zprofile chains).
# The native toolchain is bundled inside the installation, so no
# ADESH_TOOLCHAIN/ADESH_CLANG/ADESH_LLC variables are exported; users who
# register an external LLVM bridge configure those themselves.
cat > "$PROFILE_FILE" <<EOF
# AdeshLang environment (managed by the AdeshLang installer; safe to remove)
export ADESH_HOME='$HOME_DIR'
export ADESH_STD='$HOME_DIR/std'
export PATH='$HOME_DIR/bin:\$PATH'
EOF
echo "AdeshLang: wrote $PROFILE_FILE"

if [[ ! -f "$HOME_DIR/ai/models/adesh-coder-0.5b-q4_0.gguf" ]]; then
    echo "AdeshLang: AI models are not bundled in this package."
    echo "To download and set up the default offline AI coder model (~275 MB), run: adesh ai setup"
fi

# 4. Self-verify the bundled native toolchain ---------------------------------
# Fast and offline: adesh checks its compiled-in components (codegen, ADOB,
# adeshlink, runtime). A failure never fails the package.
if [[ -x "$BIN_DIR/adesh" ]]; then
    ADESH_HOME="$HOME_DIR" "$BIN_DIR/adesh" toolchain check || \
        echo "AdeshLang: native toolchain check reported issues; run 'adesh doctor' to investigate."
fi

echo "AdeshLang: core installed to $HOME_DIR (native toolchain bundled; no external LLVM required)."
exit 0
