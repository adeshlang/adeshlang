<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX Burn bootstrapper. Build with:
    wix build Bundle.wxs -ext WixToolset.Bal.wixext -ext WixToolset.Util.wixext ...

  The bundle chains only the AdeshLang MSI. The native toolchain (native
  codegen, ADOB, adeshlink, runtime) is bundled inside the MSI payload, so
  the bootstrapper downloads NOTHING extra: no LLVM, no VS Build Tools, no
  post-install toolchain action. Users who want the optional external LLVM
  bridge register it themselves with `adesh toolchain --external install`.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
      xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <?define ProductVersion = "0.3.0.0" ?>
  <?define MsiPath = "$(var.MsiPath)" ?>

  <Bundle Name="AdeshLang"
          Version="$(var.ProductVersion)"
          Manufacturer="AdeshLang Team"
          UpgradeCode="{CCB8DD91-839E-49F4-9DB6-4EC95B4C6E9A}"
          Compressed="yes"
          AboutUrl="https://github.com/adeshlang/adeshlang">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkSidebarLicense"
                                              LicenseUrl="https://github.com/adeshlang/adeshlang/blob/main/LICENSE" />
    </BootstrapperApplication>

    <Chain>
      <!-- The MSI is fully self-contained: it installs the adesh CLI,
           adeshlink, the runtime, std, AI model, and sets ADESH_HOME/PATH.
           No toolchain download or environment action is chained here. -->
      <MsiPackage Id="AdeshLangMsi"
                  SourceFile="$(var.MsiPath)"
                  DisplayName="AdeshLang (self-contained native toolchain)" />
    </Chain>
  </Bundle>
</Wix>
