<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX v4/v5 MSI for enterprise deployment.

  The MSI installs AdeshLang itself and registers its machine environment.
  The Adesh native toolchain (native codegen, ADOB object format, adeshlink
  native linker, adeshlang runtime library) is bundled inside the product: no
  external LLVM, Clang, GCC, or MSVC download or installation happens during
  setup. External LLVM remains an opt-in bridge for administrators
  (`adesh toolchain --external install`, `adesh build --external-linker`)
  and can be deployed separately after installation if desired.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?define ProductVersion = "0.3.0" ?>
  <?define UpgradeCode = "{4F58AA4C-3B54-4D7E-86B9-8B43F7C5E1B8}" ?>

  <Package Name="AdeshLang"
           Manufacturer="AdeshLang Team"
           Version="$(var.ProductVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perMachine"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of AdeshLang is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="AdeshLang">
        <Directory Id="BINDIR" Name="bin" />
        <Directory Id="LIBDIR" Name="lib" />
        <Directory Id="STDDIR" Name="std" />
        <Directory Id="CONFIGDIR" Name="config" />
        <Directory Id="LICENSEDIR" Name="licenses" />
        <!-- Bundled AI model (ai\models\adesh-coder-0.5b-q4_0.gguf) and the
             Ollama/OpenRouter deployment configs under ai\deploy. -->
        <Directory Id="AIDIR" Name="ai">
          <Directory Id="AIMODELSDIR" Name="models" />
          <Directory Id="AIDEPLOYDIR" Name="deploy" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="AdeshLang" Level="1">
      <ComponentGroupRef Id="ProductFiles" />
      <ComponentRef Id="MachineEnvironment" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="ProductFiles" Directory="INSTALLDIR">
      <Files Include="$(var.SourceDir)\bin\**" Directory="BINDIR">
        <Exclude Files="$(var.SourceDir)\bin\**\*.pdb" />
      </Files>
      <Files Include="$(var.SourceDir)\lib\**" Directory="LIBDIR" />
      <Files Include="$(var.SourceDir)\std\**" Directory="STDDIR" />
      <Files Include="$(var.SourceDir)\config\**" Directory="CONFIGDIR" />
      <Files Include="$(var.SourceDir)\licenses\**" Directory="LICENSEDIR" />
      <Files Include="$(var.SourceDir)\ai\**" Directory="AIDIR" />
    </ComponentGroup>

    <!-- Explicit GUID: this component's keypath is the directory (no file),
         so WiX cannot auto-generate its component GUID. -->
    <Component Id="MachineEnvironment" Directory="INSTALLDIR" Guid="{9A2F3F1E-6B1D-4C4A-9C7B-2E8D5A0F4B71}">
      <CreateFolder />
      <Environment Id="AdeshHomeEnvironment"
                   Name="ADESH_HOME"
                   Value="[INSTALLDIR]"
                   Part="all"
                   Action="set"
                   System="yes" />
      <!-- Only ADESH_HOME and PATH are set: the native toolchain is bundled
           and self-contained, so there is no toolchain directory to point
           ADESH_TOOLCHAIN/ADESH_CLANG/ADESH_LLC/ADESH_MLIR_* at. Users who
           opt into the external LLVM bridge configure those variables (or
           register a toolchain with `adesh toolchain --external install`)
           themselves. -->
      <Environment Id="AdeshBinPathEnvironment"
                   Name="PATH"
                   Value="[INSTALLDIR]bin"
                   Part="last"
                   Action="set"
                   System="yes" />
    </Component>
  </Fragment>
</Wix>
