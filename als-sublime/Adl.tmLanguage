    <dict>
      <key>patterns</key>
      <array>
        <dict>
          <key>name</key>
          <string>meta.section.adl</string>
          <key>match</key>
          <string>^\s*(\[)([a-zA-Z_][a-zA-Z0-9_-]*)(\])</string>
          <key>captures</key>
          <dict>
            <key>1</key>
            <dict>
              <key>name</key>
