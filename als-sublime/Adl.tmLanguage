  <key>repository</key>
  <dict>
    <key>comments</key>
    <dict>
      <key>patterns</key>
      <array>
        <dict>
          <key>name</key>
          <string>comment.line.double-slash.adl</string>
          <key>match</key>
          <string>//.*$</string>
        </dict>
        <dict>
          <key>name</key>
          <string>comment.line.number-sign.adl</string>
          <key>match</key>
          <string>#.*$</string>
        </dict>
        <dict>
          <key>name</key>
          <string>comment.block.adl</string>
          <key>begin</key>
          <string>/\*</string>
          <key>end</key>
          <string>\*/</string>
        </dict>
      </array>
    </dict>
