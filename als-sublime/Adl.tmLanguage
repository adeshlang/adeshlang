    <key>strings</key>
    <dict>
      <key>patterns</key>
      <array>
        <dict>
          <key>name</key>
          <string>string.quoted.double.adl</string>
          <key>begin</key>
          <string>"</string>
          <key>end</key>
          <string>"</string>
          <key>patterns</key>
          <array>
            <dict>
              <key>name</key>
              <string>constant.character.escape.adl</string>
              <key>match</key>
              <string>\\.</string>
            </dict>
          </array>
        </dict>
      </array>
    </dict>
    <key>versions</key>
    <dict>
      <key>patterns</key>
      <array>
        <dict>
          <key>name</key>
          <string>constant.language.version-requirement.adl</string>
          <key>match</key>
          <string>(\^|~|&gt;=|&lt;=|&gt;|&lt;|=)?\s*\d+\.\d+\.\d+([-.+][a-zA-Z0-9.+-]+)?</string>
        </dict>
        <dict>
          <key>name</key>
          <string>constant.language.version-requirement.adl</string>
          <key>match</key>
          <string>\b(any|\*)\b</string>
        </dict>
      </array>
    </dict>
    <key>booleans</key>
    <dict>
      <key>patterns</key>
      <array>
        <dict>
          <key>name</key>
          <string>constant.language.boolean.adl</string>
          <key>match</key>
          <string>\b(true|false)\b</string>
        </dict>
      </array>
    </dict>
    <key>null</key>
    <dict>
      <key>patterns</key>
