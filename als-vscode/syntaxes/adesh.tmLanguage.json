{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Adesh",
  "scopeName": "source.adesh",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#ownership-keywords" },
    { "include": "#arc-keywords" },
    { "include": "#memory-keywords" },
    { "include": "#unsafe-block" },
    { "include": "#region-block" },
    { "include": "#borrow-operators" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#classes" },
    { "include": "#types" },
    { "include": "#variables" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.adesh",
          "match": "//.*$"
        },
        {
          "name": "comment.block.adesh",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.block.documentation.adesh",
          "begin": "/\\*\\*",
          "end": "\\*/",
          "patterns": [
            {
              "name": "keyword.other.documentation.adesh",
              "match": "@(param|returns?|throws?|example|deprecated|since|see|author)\\b"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.adesh",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.adesh",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.expression.adesh",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.adesh",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.adesh",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.template.adesh",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.adesh",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.expression.adesh",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.adesh",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.adesh",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.adesh",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.adesh",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.complex.adesh",
          "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?j\\b"
        },
        {
          "name": "constant.numeric.typed.adesh",
          "match": "\\b[0-9][0-9_]*(u8|u16|u32|u64|u128|i8|i16|i32|i64|i128|f32|f64)\\b"
        },
        {
          "name": "constant.numeric.integer.adesh",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "ownership-keywords": {
      "patterns": [
        {
          "name": "keyword.other.ownership.adesh",
          "match": "\\b(owned|borrowed|shared|unique|noalias|move|transfer|copy)\\b"
        },
        {
          "name": "keyword.control.borrow.adesh",
          "match": "\\b(borrow|borrow_mut|endborrow)\\b"
        },
        {
          "name": "keyword.control.drop.adesh",
          "match": "\\b(drop|destroy)\\b"
        }
      ]
    },
    "arc-keywords": {
      "name": "keyword.other.arc.adesh",
      "match": "\\b(share|strong|weak)\\b"
    },
    "memory-keywords": {
      "patterns": [
        {
          "name": "keyword.other.memory.adesh",
          "match": "\\b(alloc|free|alloc_typed|ptr_offset|ptr_read|ptr_write|heap|stack|region|arena)\\b"
        },
        {
          "name": "keyword.other.pointer.adesh",
          "match": "\\b(ptr|deref|addr|sizeof|alignof|offsetof)\\b"
        }
      ]
    },
    "unsafe-block": {
      "patterns": [
        {
          "name": "meta.unsafe.adesh",
          "begin": "\\b(unsafe)\\s*\\{",
          "beginCaptures": {
            "1": { "name": "keyword.control.unsafe.adesh" }
          },
          "end": "\\}",
          "patterns": [
            { "include": "$self" }
          ]
        },
        {
          "name": "keyword.control.unsafe.adesh",
          "match": "\\b(unsafe)\\b"
        }
      ]
    },
    "region-block": {
      "patterns": [
        {
          "name": "meta.region.adesh",
          "begin": "\\b(region)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\{",
          "beginCaptures": {
            "1": { "name": "keyword.control.region.adesh" },
            "2": { "name": "entity.name.region.adesh" }
          },
          "end": "\\}",
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "borrow-operators": {
      "patterns": [
        {
          "name": "keyword.operator.borrow.mutable.adesh",
          "match": "&mut\\b"
        },
        {
          "name": "keyword.operator.borrow.shared.adesh",
          "match": "&(?!&)"
        },
        {
          "name": "keyword.operator.dereference.adesh",
          "match": "\\*(?=[a-zA-Z_])"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.adesh",
          "match": "\\b(if|else|elif|while|do|for|in|return|break|continue|try|catch|throw|delete|match|await|yield|defer|panic|unreachable|true|false|null|nil|none|None|this|super|self|Self)\\b"
        },
        {
          "name": "keyword.declaration.adesh",
          "match": "\\b(let|const|test|fn|class|extend|enum|interface|struct|type|async|pub|mut|decorator|sealed)\\b"
        },
        {
          "name": "keyword.other.adesh",
          "match": "\\b(import|export|from|as|raw|new|extends|implements|static|abstract|where|is|typeof|sizeof|alignof|get|set|on)\\b"
        },
        {
          "name": "storage.modifier.adesh",
          "match": "\\b(public|private|protected|readonly|override|virtual|final|inline|extern|volatile)\\b"
        },
        {
          "name": "keyword.control.loop-label.adesh",
          "match": "'[a-zA-Z_][a-zA-Z0-9_]*:"
        },
        {
          "name": "meta.decorator.adesh",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*",
          "captures": {
            "0": { "name": "entity.name.function.decorator.adesh" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.adesh",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.logical.adesh",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.adesh",
          "match": "(=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=)"
        },
        {
          "name": "keyword.operator.comparison.adesh",
          "match": "(===|==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.adesh",
          "match": "(\\+|-|\\*|/|%|\\^)"
        },
        {
          "name": "keyword.operator.bitwise.adesh",
          "match": "(&|\\||\\^|~|<<|>>)"
        },
        {
          "name": "keyword.operator.range.adesh",
          "match": "(\\.\\.|\\.\\.=)"
        },
        {
          "name": "keyword.operator.optional.adesh",
          "match": "(\\?\\.)"
        },
        {
          "name": "keyword.operator.spread.adesh",
          "match": "(\\.\\.\\.)"
        },
        {
          "name": "keyword.operator.arrow.adesh",
          "match": "(->|=>)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.adesh",
          "match": "\\b(assert|assert_eq|assert_ne)\\b(?=\\s*\\()"
        },
        {
          "name": "meta.function.definition.unsafe_fn.adesh",
          "match": "\\b(unsafe)\\s+(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(<[^>]*>)?\\s*(?=\\()",
          "captures": {
            "1": { "name": "keyword.control.unsafe.adesh" },
            "2": { "name": "keyword.declaration.adesh" },
            "3": { "name": "entity.name.function.adesh" },
            "4": { "name": "meta.generic.adesh" }
          }
        },
        {
          "name": "meta.function.definition.adesh",
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(<[^>]*>)?\\s*(?=\\()",
          "captures": {
            "1": { "name": "keyword.declaration.adesh" },
            "2": { "name": "entity.name.function.adesh" },
            "3": { "name": "meta.generic.adesh" }
          }
        },
        {
          "name": "meta.function.definition.unsafe.adesh",
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(<[^>]*>)?\\s*\\([^)]*\\)\\s*(->\\s*[^{]+)?\\s*(unsafe)\\s*(?=\\{)",
          "captures": {
            "1": { "name": "keyword.declaration.adesh" },
            "2": { "name": "entity.name.function.adesh" },
            "3": { "name": "meta.generic.adesh" },
            "4": { "name": "entity.name.type.adesh" },
            "5": { "name": "keyword.control.unsafe.adesh" }
          }
        },
        {
          "name": "entity.name.function.adesh",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "classes": {
      "patterns": [
        {
          "name": "meta.class.definition.adesh",
          "match": "\\b(class|interface|enum|struct)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(<[^>]*>)?",
          "captures": {
            "1": { "name": "keyword.declaration.adesh" },
            "2": { "name": "entity.name.type.class.adesh" },
            "3": { "name": "meta.generic.adesh" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.adesh",
          "match": "\\b(int|i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|f32|f64|float|double|bool|string|str|char|tuple|set|object|map|complex|void|any|never|unknown)\\b"
        },
        {
          "name": "keyword.operator.type.union.adesh",
          "match": "\\|"
        },
        {
          "name": "support.type.pointer.adesh",
          "match": "\\*[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "entity.name.type.adesh",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.language.adesh",
          "match": "\\b(this|super|self|Self)\\b"
        },
        {
          "name": "variable.other.adesh",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.adesh",
          "match": "\\b(true|false|null|nil|none|None)\\b"
        },
        {
          "name": "support.constant.adesh",
          "match": "\\b(Math|time|console|fs|io)\\b"
        },
        {
          "name": "constant.other.caps.adesh",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        }
      ]
    }
  }
}
