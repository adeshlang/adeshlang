// Type Keyword Test Runner & Analytics Suite
// Imports test cases from all type_keyword test modules and executes them
// step-by-step with rich analytics reporting.

import "./01_type_aliases.test.adesh" as alias_tests;
import "./02_generic_aliases.test.adesh" as generic_tests;
import "./03_advanced_typescript_patterns.test.adesh" as adv_tests;

// ─────────────────────────────────────────────────────────────
// Native Test Harness Declarations (for `adesh test`)
// ─────────────────────────────────────────────────────────────

export test fn test_suite_type_aliases() {
    alias_tests.run_tests();
}

export test fn test_suite_generic_aliases() {
    generic_tests.run_tests();
}

export test fn test_suite_advanced_typescript_patterns() {
    adv_tests.run_tests();
}

// ─────────────────────────────────────────────────────────────
// Standalone Test Runner & Analytics Engine
// ─────────────────────────────────────────────────────────────

struct TestSuiteResult {
    suite_name: string;
    total: i32;
    passed: i32;
    failed: i32;
};


fn print_analytics_dashboard(
    alias_res: TestSuiteResult,
    generic_res: TestSuiteResult,
    adv_res: TestSuiteResult
) {
    let total_all = alias_res.total + generic_res.total + adv_res.total;
    let passed_all = alias_res.passed + generic_res.passed + adv_res.passed;
    let failed_all = alias_res.failed + generic_res.failed + adv_res.failed;
    let pass_rate = (passed_all * 100) / total_all;

    let a_rate = (alias_res.passed * 100) / alias_res.total;
    let g_rate = (generic_res.passed * 100) / generic_res.total;
    let adv_rate = (adv_res.passed * 100) / adv_res.total;

    print("");
    print("╔══════════════════════════════════════════════════════════════════════════╗");
    print("║                       TEST ANALYTICS DASHBOARD                           ║");
    print("╠══════════════════════════════════════════════════════════════════════════╣");
    print("║  Suite Name                        │ Total │ Passed │ Failed │ Pass Rate ║");
    print("╟────────────────────────────────────┼───────┼────────┼────────┼───────────╢");
    print(`║  01_type_aliases                   │   ${alias_res.total}   │   ${alias_res.passed}    │   ${alias_res.failed}    │   ${a_rate}%   ║`);
    print(`║  02_generic_aliases                │   ${generic_res.total}   │   ${generic_res.passed}    │   ${generic_res.failed}    │   ${g_rate}%   ║`);
    print(`║  03_advanced_typescript_patterns   │   ${adv_res.total}   │   ${adv_res.passed}    │   ${adv_res.failed}    │   ${adv_rate}%   ║`);
    print("╠══════════════════════════════════════════════════════════════════════════╣");
    print(`║  TOTAL OVERALL                     │  ${total_all}   │  ${passed_all}   │   ${failed_all}    │   ${pass_rate}%   ║`);
    print("╚══════════════════════════════════════════════════════════════════════════╝");
    print("");
    if (failed_all == 0) {
        print(`  🎉 ALL TYPE KEYWORD TESTS PASSED SUCCESSFULLY! (${passed_all}/${total_all} tests)`);
    } else {
        print(`  ⚠️ WARNING: ${failed_all} test(s) failed.`);
    }
    print("");
}

fn main() {
    print("╔══════════════════════════════════════════════════════════════════════════╗");
    print("║             AdeshLang Type Keyword - Test Execution Runner               ║");
    print("╚══════════════════════════════════════════════════════════════════════════╝");
    print("");

    // Suite 1: Type Alias Tests
    print("▶ [1/3] Running Suite: 01_type_aliases.test.adesh");
    let a1 = 0;
    alias_tests.test_alias_field_construction();
    print("  ✓ PASS: alias_tests.test_alias_field_construction");
    a1 = a1 + 1;

    alias_tests.test_alias_field_override();
    print("  ✓ PASS: alias_tests.test_alias_field_override");
    a1 = a1 + 1;

    alias_tests.test_missing_optional_is_null();
    print("  ✓ PASS: alias_tests.test_missing_optional_is_null");
    a1 = a1 + 1;

    alias_tests.test_function_parameter_defaults();
    print("  ✓ PASS: alias_tests.test_function_parameter_defaults");
    a1 = a1 + 1;

    alias_tests.test_make_user_defaults();
    print("  ✓ PASS: alias_tests.test_make_user_defaults");
    a1 = a1 + 1;

    alias_tests.test_typeof_sizeof_alias_instance();
    print("  ✓ PASS: alias_tests.test_typeof_sizeof_alias_instance");
    a1 = a1 + 1;

    let alias_res = TestSuiteResult {
        suite_name: "01_type_aliases",
        total: 6,
        passed: a1,
        failed: 6 - a1,
    };
    print(`  Suite Result: ${a1}/6 tests passed\n`);

    // Suite 2: Generic Type Alias Tests
    print("▶ [2/3] Running Suite: 02_generic_aliases.test.adesh");
    let g1 = 0;
    generic_tests.test_box_optional_tag_missing();
    print("  ✓ PASS: generic_tests.test_box_optional_tag_missing");
    g1 = g1 + 1;

    generic_tests.test_box_alias_tag_override();
    print("  ✓ PASS: generic_tests.test_box_alias_tag_override");
    g1 = g1 + 1;

    generic_tests.test_box_value_accessor();
    print("  ✓ PASS: generic_tests.test_box_value_accessor");
    g1 = g1 + 1;

    generic_tests.test_pair_alias_roundtrip();
    print("  ✓ PASS: generic_tests.test_pair_alias_roundtrip");
    g1 = g1 + 1;

    generic_tests.test_nested_generic_alias();
    print("  ✓ PASS: generic_tests.test_nested_generic_alias");
    g1 = g1 + 1;

    let generic_res = TestSuiteResult {
        suite_name: "02_generic_aliases",
        total: 5,
        passed: g1,
        failed: 5 - g1,
    };
    print(`  Suite Result: ${g1}/5 tests passed\n`);

    // Suite 3: Advanced TypeScript Patterns & Edge Cases
    print("▶ [3/3] Running Suite: 03_advanced_typescript_patterns.test.adesh");
    let adv1 = 0;
    adv_tests.test_scalar_fixed_width_boundaries();
    print("  ✓ PASS: adv_tests.test_scalar_fixed_width_boundaries");
    adv1 = adv1 + 1;

    adv_tests.test_chained_scalar_aliases();
    print("  ✓ PASS: adv_tests.test_chained_scalar_aliases");
    adv1 = adv1 + 1;

    adv_tests.test_dotted_member_types_direct_and_func();
    print("  ✓ PASS: adv_tests.test_dotted_member_types_direct_and_func");
    adv1 = adv1 + 1;

    adv_tests.test_deep_three_level_dotted_type();
    print("  ✓ PASS: adv_tests.test_deep_three_level_dotted_type");
    adv1 = adv1 + 1;

    adv_tests.test_generic_utility_type_composition();
    print("  ✓ PASS: adv_tests.test_generic_utility_type_composition");
    adv1 = adv1 + 1;

    adv_tests.test_alias_introspection();
    print("  ✓ PASS: adv_tests.test_alias_introspection");
    adv1 = adv1 + 1;

    let adv_res = TestSuiteResult {
        suite_name: "03_advanced_typescript_patterns",
        total: 6,
        passed: adv1,
        failed: 6 - adv1,
    };
    print(`  Suite Result: ${adv1}/6 tests passed\n`);

    // Final Analytics Dashboard
    print_analytics_dashboard(alias_res, generic_res, adv_res);
}
