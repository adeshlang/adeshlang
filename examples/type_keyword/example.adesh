type Port = u16;

type Service = {
  name: string,
  port: Port,
}

let api: Service = {
  name: "edge-api",
  port: 8080,
};

let port: Service.port = api.port;
print("port:", port);
print("service:", api.name, "→", api.port);
print("Type of Port:", typeof(Port));
print("Type of Service:", typeof(Service));
print("Type of Service.name:", typeof(Service.name));
print("Type of api", typeof(api));
print("Type of Service.port:", typeof(Service.port));
