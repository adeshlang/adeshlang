// ─────────────────────────────────────────────────────────────
// AdeshLang: Generic Type Aliases & Utility Types
// ─────────────────────────────────────────────────────────────
// Demonstrates parameterized type aliases (analogous to TypeScript's
// generic interfaces and utility types like `Record<K, V>`, `ApiResponse<T>`).
//
// Can be executed via:
//   1. Direct run: `adesh run examples/type_keyword/03_generic_utility_types.adesh`
//   2. Test runner: `adesh test examples/type_keyword/03_generic_utility_types.adesh`

type HttpCode = u16;

type Container<T> = {
    value: T,
    tag?: string = "generic-box",
};

type Pair<A, B> = {
    first: A,
    second: B,
};

type ApiResponse<T> = {
    status: HttpCode,
    payload: T,
    error?: string,
};

type UserInfo = {
    username: string,
    role: string,
};

fn wrap_in_container<T>(val: T, tag_str: string): Container<T> {
    return {
        value: val,
        tag: tag_str,
    };
}

fn make_pair<A, B>(a: A, b: B): Pair<A, B> {
    return {
        first: a,
        second: b,
    };
}

fn create_api_success<T>(data: T): ApiResponse<T> {
    return {
        status: 200,
        payload: data,
    };
}

// ─────────────────────────────────────────────────────────────
// Test Suite Declarations (for `adesh test`)
// ─────────────────────────────────────────────────────────────

test fn test_generic_container_defaults_and_override() {
    let box1 = wrap_in_container(42, "number-box");
    assert_eq(box1.value, 42);
    assert_eq(box1.tag, "number-box");

    let box2 = wrap_in_container("hello", "text-box");
    assert_eq(box2.value, "hello");
    assert_eq(box2.tag, "text-box");
}

test fn test_generic_pair_construction() {
    let pair = make_pair("port", 8080);
    assert_eq(pair.first, "port");
    assert_eq(pair.second, 8080);
}

test fn test_generic_api_response_wrapper() {
    let user: UserInfo = {
        username: "developer_ajay",
        role: "admin",
    };
    let response = create_api_success(user);
    assert_eq(response.status, 200);
    assert_eq(response.payload.username, "developer_ajay");
    assert_eq(response.payload.role, "admin");
    assert_eq(response.error, null);
}

// ─────────────────────────────────────────────────────────────
// Standalone Direct Runner (for `adesh run`)
// ─────────────────────────────────────────────────────────────

export fn run_tests(): i32 {
    test_generic_container_defaults_and_override();
    test_generic_pair_construction();
    test_generic_api_response_wrapper();
    return 3;
}

fn main() {
    print("=== [AdeshLang] 03: Generic Utility Types Example ===");

    let num_box = wrap_in_container(1024, "mem-alloc");
    let kv_pair = make_pair("gateway_timeout", 30);

    let profile: UserInfo = {
        username: "system_admin",
        role: "root",
    };
    let api_resp = create_api_success(profile);

    print(`Box Tag         : ${num_box.tag} (value: ${num_box.value})`);
    print(`Config Pair     : ${kv_pair.first} = ${kv_pair.second}`);
    print(`API Status Code : ${api_resp.status}`);
    print(`Payload User    : ${api_resp.payload.username} [${api_resp.payload.role}]`);

    // Self-verifying assertions
    assert_eq(num_box.value, 1024);
    assert_eq(kv_pair.second, 30);
    assert_eq(api_resp.status, 200);

    let passed = run_tests();
    print(`✓ Executed ${passed} inline unit tests successfully!`);
}
