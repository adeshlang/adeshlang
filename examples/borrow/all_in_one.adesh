// examples/borrow/all_in_one.adesh
// All-in-One Borrow Feature Demonstration and Test Suite

let PASS_COUNT = 0;
let FAIL_COUNT = 0;

fn adesh_assert(cond, msg) {
    if (cond) {
        print("  ✓ PASS:", msg);
        PASS_COUNT = PASS_COUNT + 1;
    } else {
        print("  ✗ FAIL:", msg);
        FAIL_COUNT = FAIL_COUNT + 1;
    }
}

print("=== Borrow All-In-One Feature Suite ===");

let value = { x: 100 };
adesh_assert(value.x == 100, "Borrowed struct property access");

fn read_x(obj) {
    return obj.x;
}
adesh_assert(read_x(value) == 100, "Function argument borrow read");

print("\nBorrow All-In-One Test Summary:");
print("  Passed:", PASS_COUNT);
print("  Failed:", FAIL_COUNT);
assert(FAIL_COUNT == 0);
