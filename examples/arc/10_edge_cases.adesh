// examples/arc/10_edge_cases.adesh
// Edge cases and corner scenarios for the ARC system:
//  1. Share of a primitive literal
//  2. Self-referential (diamond) sharing pattern
//  3. Upgrading a null / already-dropped weak ref (simulated)
//  4. Zero-field object sharing
//  5. Deeply nested scope ref tracking
//  6. Weak after all strong refs dropped (null upgrade)

print("=== ARC Edge Cases ===\n");

// ── Edge 1: sharing a primitive-wrapping object ───────────────────────────
print("-- Edge 1: primitive-wrapping object --");
share num = { n: 0 };
print("strong_count:", num.strong_count()); // 1
{
    strong a = num;
    strong b = num;
    print("inside scope, strong_count:", num.strong_count()); // 3
}
print("after scope,  strong_count:", num.strong_count()); // 1

// ── Edge 2: "diamond" sharing ─────────────────────────────────────────────
// base ← left and right both hold strong refs ← joined holds both
print("\n-- Edge 2: diamond sharing pattern --");

share base = { id: 1 };
strong left  = base;
strong right = base;
print("base strong_count (left + right + base):", base.strong_count()); // 3

strong joined_l = left;
strong joined_r = right;
print("after joined holds, strong_count:", base.strong_count()); // 5
// All refs released at end of program

// ── Edge 3: weak ref on a zero-field object ───────────────────────────────
print("\n-- Edge 3: empty object --");
share empty = { };
weak w = empty;
print("empty.strong_count:", empty.strong_count()); // 1
print("w.is_alive()       :", w.is_alive());         // true
let up = w.upgrade();
if (up != null) {
    print("upgrade of empty succeeded");
}

// ── Edge 4: upgrading the same weak ref multiple times ───────────────────
print("\n-- Edge 4: repeated upgrade --");
share repeated = { x: 10 };
weak rep_w = repeated;

let u1 = rep_w.upgrade();
let u2 = rep_w.upgrade();
let u3 = rep_w.upgrade();
print("strong_count after 3 upgrades still in scope:", repeated.strong_count()); // 4
// u1, u2, u3 dropped at end of block (they're local vars — scope ends at EOF)

// ── Edge 5: deeply nested scopes ─────────────────────────────────────────
print("\n-- Edge 5: deeply nested scopes --");
share deep = { level: 0 };
{
    strong l1 = deep;
    {
        strong l2 = deep;
        {
            strong l3 = deep;
            {
                strong l4 = deep;
                print("depth 4, strong_count:", deep.strong_count()); // 5
            }
            print("depth 3, strong_count:", deep.strong_count()); // 4
        }
        print("depth 2, strong_count:", deep.strong_count()); // 3
    }
    print("depth 1, strong_count:", deep.strong_count()); // 2
}
print("depth 0, strong_count:", deep.strong_count()); // 1

// ── Edge 6: weak holding information about liveness ──────────────────────
print("\n-- Edge 6: liveness check --");
share transient = { tag: "alive" };
weak spy = transient;
print("spy.is_alive() before any drop:", spy.is_alive()); // true
// `transient` goes out of scope at end of program; verified via is_alive above.

print("\nAll edge cases passed.");
