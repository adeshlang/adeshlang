// AdeshLang - Variables in Range Operators
// Demonstrates that variables (and expressions) work in both .. and ... range operators
// FIXED: Range operators now properly support variables in ALL backends

print("=== VARIABLES IN RANGE OPERATORS ===\n");

// ============================================
// Test 1: Simple variables in ranges
// ============================================
print("Test 1: Using variables in exclusive range (..)");
let start = 0;
let end = 5;

for (i in start..end) {
    print("i =", i);
}
print("");

// ============================================
// Test 2: Variables in inclusive ranges
// ============================================
print("Test 2: Using variables in inclusive range (...)");
let a = 2;
let b = 7;

for (i in a...b) {
    print("i =", i);
}
print("");

// ============================================
// Test 3: Using expressions in ranges
// ============================================
print("Test 3: Using expressions in ranges");
let x = 3;
let y = 10;

for (i in (x + 1)..(y - 2)) {
    print("i =", i);
}
print("");

// ============================================
// Test 4: Function parameters in ranges
// ============================================
print("Test 4: Function parameters in ranges");

fn sumRange(start, end) {
    let sum = 0;
    for (i in start..end) {
        sum = sum + i;
    }
    return sum;
}

print("sumRange(0, 5) =", sumRange(0, 5));     // 0+1+2+3+4 = 10
print("sumRange(1, 6) =", sumRange(1, 6));     // 1+2+3+4+5 = 15
print("sumRange(10, 20) =", sumRange(10, 20)); // Sum of 10..19
print("");

// ============================================
// Test 5: Nested ranges with variables
// ============================================
print("Test 5: Nested ranges");

fn printMatrix(rows, cols) {
    for (i in 0..rows) {
        let line = "";
        for (j in 0..cols) {
            line = line + (i * cols + j) + " ";
        }
        print(line);
    }
}

printMatrix(3, 4);
print("");

// ============================================
// Test 6: Range in array construction
// ============================================
print("Test 6: Range in array literal");
let n = 5;
let arr = [0..n];  // Create array [0,1,2,3,4]
print("arr =", arr);
print("");

// ============================================
// Test 7: Validating non-numeric values
// ============================================
print("Test 7: Error handling for invalid range bounds");

fn safeSum(start, end) {
    // Check if inputs are valid numbers
    if (start == null || end == null) {
        print("ERROR: Range bounds cannot be null");
        return -1;
    }
    
    let sum = 0;
    for (i in start..end) {
        sum = sum + i;
    }
    return sum;
}

print("safeSum(1, 5) =", safeSum(1, 5));
print("safeSum(null, 5) =", safeSum(null, 5));  // Now handled gracefully
print("");

print("✅ ALL VARIABLE RANGE TESTS COMPLETED!");
print("");
print("Summary:");
print("- Variables work in exclusive ranges (x..y)");
print("- Variables work in inclusive ranges (x...y)");
print("- Expressions work in ranges ((a+1)..(b-1))");
print("- Function parameters work in ranges");
print("- Ranges work in nested loops");
print("- Ranges work in array literals");
