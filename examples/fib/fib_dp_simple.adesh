// Simpler DP approach with just two variables

fn fib_dp(n) {
    print("fib_dp called with n =", n);
    if (n <= 1) {
        print("Base case, returning", n);
        return n;
    }
    
    let prev = 0;
    let curr = 1;
    let i = 2;
    
    print("Before loop: prev =", prev, "curr =", curr, "i =", i, "n =", n);
    
    let should_continue = i <= n;
    while (should_continue) {
        print("Loop iteration: i =", i);
        let next = prev + curr;
        print("  next =", next, "(", prev, "+", curr, ")");
        prev, curr = curr, next;
        print("  After update: prev =", prev, "curr =", curr);
        i = i + 1;
        print("  After i++: i =", i);
        should_continue = i <= n;
        print("  should_continue =", should_continue);
    }
    
    print("After loop, returning curr =", curr);
    return curr;
}

let result = fib_dp(10);
print("Final result:", result);
print("Expected: 55");
