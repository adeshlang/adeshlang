// Section 5: Benchmarks
print("\n--- Performance Benchmarks ---");

print("Benchmarking fib_naive(20):");
let start1 = clock();
let result1 = fib_naive(20);
let end1 = clock();
print("Result:", result1, "Time:", end1 - start1, "seconds");

print("Benchmarking fib_dp_simple(30):");
let start2 = clock();
let result2 = fib_dp_simple(30);
let end2 = clock();
print("Result:", result2, "Time:", end2 - start2, "seconds");

// Section 6: Additional Examples
print("\n--- Additional Examples ---");

// Fibonacci sequence generator
fn fib_sequence(count) {
    if (count <= 0) {
        return [];
    }
    if (count == 1) {
        return [0];
    }
    if (count == 2) {
        return [0, 1];
    }
    let seq: Any = [0, 1];
    let i = 2;
    while (i < count) {
        seq = seq.append(seq[i-1] + seq[i-2]);
        i = i + 1;
    }
    return seq;
}

print("First 10 Fibonacci numbers:", fib_sequence(10));
print("First 15 Fibonacci numbers:", fib_sequence(15));

// Check if number is Fibonacci
fn is_fibonacci(num) {
    if (num < 0) {
        return false;
    }
    let a = 0;
    let b = 1;
    while (b < num) {
        a, b = b, a + b;
    }
    return b == num || a == num;
}

print("Is 13 a Fibonacci number?", is_fibonacci(13));
print("Is 14 a Fibonacci number?", is_fibonacci(14));

