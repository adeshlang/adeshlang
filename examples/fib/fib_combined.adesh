// fib_combined.ind — Comprehensive Fibonacci and Factorial examples
// Combining all fib-related examples with additional implementations

print("=== Comprehensive Fibonacci and Factorial Examples ===");

// Section 1: Naive Recursive Approach
print("\n--- Naive Recursive Fibonacci ---");

fn fib_naive(n) {
    if (n <= 1) {
        return n;
    }
    return fib_naive(n - 1) + fib_naive(n - 2);
}

print("fib_naive(10) =", fib_naive(10));
print("fib_naive(12) =", fib_naive(12));

// Section 2: Dynamic Programming Iterative Approaches
print("\n--- Dynamic Programming Iterative ---");

// Simple DP with two variables
fn fib_dp_simple(n) {
    if (n <= 1) {
        return n;
    }
    let prev = 0;
    let curr = 1;
    let i = 2;
    while (i <= n) {
        prev, curr = curr, prev + curr;
        i = i + 1;
    }
    return curr;
}

print("fib_dp_simple(10) =", fib_dp_simple(10));
print("fib_dp_simple(20) =", fib_dp_simple(20));

// DP using array for state
fn fib_dp_array(n) {
    if (n <= 1) {
        return n;
    }
    let state = [0, 1];
    let i = 2;
    while (i <= n) {
        let a = state[0];
        let b = state[1];
        let next = a + b;
        state = [b, next];
        i = i + 1;
    }
    return state[1];
}

print("fib_dp_array(10) =", fib_dp_array(10));
print("fib_dp_array(20) =", fib_dp_array(20));

// DP with while(true) and break
fn fib_dp_break(n) {
    if (n <= 1) {
        return n;
    }
    let prev = 0;
    let curr = 1;
    let i = 2;
    while (true) {
        if (i > n) {
            break;
        }
        prev, curr = curr, prev + curr;
        i = i + 1;
    }
    return curr;
}

print("fib_dp_break(10) =", fib_dp_break(10));
print("fib_dp_break(20) =", fib_dp_break(20));

// Section 3: Additional DP Variations
print("\n--- Additional DP Variations ---");

print("fib_dp_array(15) =", fib_dp_array(15));
print("fib_dp_break(15) =", fib_dp_break(15));

// Section 4: Factorial Examples
print("\n--- Factorial Examples ---");

fn factorial_iterative(n) {
    let result = 1;
    let i = 2;
    while (i <= n) {
        result = result * i;
        i = i + 1;
    }
    return result;
}

fn factorial_recursive(n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial_recursive(n - 1);
}

