// factorial.ind — Comprehensive factorial calculation examples

print("=== Factorial Examples ===");

fn factorial_iterative(n) {
    let result = 1;
    let i = 2;
    while (i <= n) {
        result = result * i;
        i = i + 1;
    }
    return result;
}

fn factorial_recursive(n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial_recursive(n - 1);
}

print("factorial_iterative(5) =", factorial_iterative(5));
print("factorial_iterative(10) =", factorial_iterative(10));
print("factorial_recursive(5) =", factorial_recursive(5));
print("factorial_recursive(10) =", factorial_recursive(10));

// BigInt factorial for large numbers (from original factorial.ind)
fn factorial_bigint(n) {
    let acc = 1n;
    let i = 2n;
    while (i <= n) {
        acc = acc * i;
        i = i + 1n;
    }
    return acc;
}

print("factorial_bigint(20n) =", factorial_bigint(20n));
print("factorial_bigint(50n) =", factorial_bigint(50n));

// Benchmark the bigint factorial
let start = clock();
let result = factorial_bigint(100n);
let end = clock();
print("Factorial of 100n =", result);
print("Time:", (end - start) * 1000, "ms");
print("Result type:", typeof(result));

print("=== Factorial Examples Complete ===");


