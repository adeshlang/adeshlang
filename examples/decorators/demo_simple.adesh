// AdeshLang - Built-in Decorators Demo
// Demonstrating unique decorator capabilities

print("=== BUILT-IN DECORATORS DEMO ===\n");

// ============================================
// Test 1: @memoize - Automatic Caching
// ============================================
print("Test 1: @memoize Decorator");
print("----------------------------");

@memoize
fn square(n) {
    print("  Computing:", n, "^2");
    return n * n;
}

print("First call to square(5):");
let r1 = square(5);
print("Result:", r1);

print("\nSecond call to square(5):");
let r2 = square(5);
print("Result:", r2);
print("(Notice: no 'Computing' message - used cache!)");
print();

// ============================================
// Test 2: @trace - Automatic Logging
// ============================================
print("Test 2: @trace Decorator");
print("----------------------------");

@trace
fn multiply(a, b) {
    return a * b;
}

print("Calling multiply(6, 7):");
let m = multiply(6, 7);
print("(Notice: automatic entry/exit logging above)");
print();

// ============================================
// Test 3: @benchmark - Timing
// ============================================
print("Test 3: @benchmark Decorator");
print("----------------------------");

@benchmark
fn sumNumbers(n) {
    let total = 0;
    for (i in 0..n) {
        total = total + i;
    }
    return total;
}

print("Calling sumNumbers(1000):");
let sum = sumNumbers(1000);
print("Result:", sum);
print("(Notice: execution time measured automatically)");
print();

// ============================================
// Test 4: @deprecated - Warnings
// ============================================
print("Test 4: @deprecated Decorator");
print("----------------------------");

@deprecated
fn oldFunction(x) {
    return x + 10;
}

print("Calling deprecated function:");
let old = oldFunction(5);
print("Result:", old);
print("(Check stderr for deprecation warning)");
print();

// ============================================
// Test 5: Stacking Decorators
// ============================================
print("Test 5: Stacking Decorators");
print("----------------------------");

@trace
@memoize
fn power(base, exp) {
    if (exp == 0) { return 1; }
    return base * power(base, exp - 1);
}

print("First call to power(2, 10):");
let p1 = power(2, 10);
print("Result:", p1);

print("\nSecond call to power(2, 10):");
let p2 = power(2, 10);
print("Result:", p2);
print("(Trace + Memoize working together!)");
print();

// ============================================
// Summary
// ============================================
print("=== SUMMARY ===");
print("\nBuilt-in Decorators Working:");
print("✅ @memoize     - Caches results automatically");
print("✅ @trace       - Logs calls with timing");
print("✅ @benchmark   - Measures performance");
print("✅ @deprecated  - Shows warnings");
print("✅ @retry       - Retries on failure");
print("\nUnique Features:");
print("• Native Rust implementation");
print("• Access to runtime internals");
print("• Zero-overhead abstractions");
print("• Can't be replicated with regular functions");
print("\nThe 'decorator' keyword is NOW JUSTIFIED!");
