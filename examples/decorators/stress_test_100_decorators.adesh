decorator d18(target, meta) { return fn(x) { return target(x); }; }
decorator d19(target, meta) { return fn(x) { return target(x); }; }
decorator d20(target, meta) { return fn(x) { return target(x); }; }

// Apply first 20 decorators
@d1 @d2 @d3 @d4 @d5 @d6 @d7 @d8 @d9 @d10
@d11 @d12 @d13 @d14 @d15 @d16 @d17 @d18 @d19 @d20
fn test20(x) {
    return x * 2;
}

print("Testing 20 decorators...");
let start = clock();
let result = test20(100);
let elapsed = clock() - start;
print("Result:", result, "Time:", elapsed, "ms");

