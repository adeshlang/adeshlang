// Stress test: 100+ decorators to verify no hanging
// This test ensures the O(N) pipeline construction works correctly

// Create 100 simple passthrough decorators
decorator d1(target, meta) { return fn(x) { return target(x); }; }
decorator d2(target, meta) { return fn(x) { return target(x); }; }
