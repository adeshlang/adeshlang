// AdeshLang - Built-in Decorators Demo
// Shows how built-in decorators provide unique capabilities

print("=== BUILT-IN DECORATORS: UNIQUE FEATURES ===\n");

// ============================================
// 1. @memoize - Automatic Caching
// ============================================
print("1. @memoize - Automatic Caching");
print("----------------------------------------");

// Regular function without caching
fn fibonacciSlow(n) {
    if (n <= 1) { return n; }
    return fibonacciSlow(n-1) + fibonacciSlow(n-2);
}

// Function with built-in @memoize decorator
@memoize
fn fibonacciFast(n) {
    if (n <= 1) { return n; }
    return fibonacciFast(n-1) + fibonacciFast(n-2);
}

print("Computing fibonacci(20) without caching...");
let start1 = clock();
let result1 = fibonacciSlow(20);
let time1 = clock() - start1;
print("Result:", result1, "Time:", time1.toFixed(4), "seconds");

print("\nComputing fibonacci(20) WITH @memoize...");
let start2 = clock();
let result2 = fibonacciFast(20);
let time2 = clock() - start2;
print("Result:", result2, "Time:", time2.toFixed(4), "seconds");

let speedup = (time1 / time2);
print("@memoize is", speedup.toFixed(1), "x FASTER!");
print("✨ Unique: Automatic caching without manual code!\n");

// ============================================
// 2. @trace - Automatic Logging
// ============================================
print("2. @trace - Call Tracing with Timing");
print("----------------------------------------");

@trace
fn complexCalculation(a, b, c) {
    let step1 = a + b;
    let step2 = step1 * c;
    let step3 = step2 / 2;
    return step3;
}

print("Calling traced function:");
let traced = complexCalculation(10, 20, 3);
print("✨ Unique: Automatic entry/exit logging with timing!\n");

// ============================================
// 3. @benchmark - Performance Measurement
// ============================================
print("3. @benchmark - Execution Time");
print("----------------------------------------");

@benchmark
fn processArray(size) {
    let sum = 0;
    for (i in 0..size) {
        sum = sum + i;
    }
    return sum;
}

let bench_result = processArray(1000);
print("Sum result:", bench_result);
print("✨ Unique: Zero-overhead timing built-in!\n");

// ============================================
// 4. @deprecated - Deprecation Warnings
// ============================================
print("4. @deprecated - Function Deprecation");
print("----------------------------------------");

@deprecated
fn oldStyleCalculate(x) {
    return x * 2;
}

fn newStyleCalculate(x) {
    return x * 3;
}

print("Calling deprecated function (watch stderr):");
let old = oldStyleCalculate(5);
print("Result:", old);
print("✨ Unique: Standardized deprecation system!\n");

// ============================================
// 5. @retry - Automatic Retry Logic
// ============================================
print("5. @retry - Auto Retry on Failure");
print("----------------------------------------");

let callCount = 0;

@retry(3, 500)
fn unreliableOperation() {
    callCount = callCount + 1;
    
    // Fail first 2 times
    if (callCount < 3) {
        throw Error("Simulated failure");
    }
    
    return "Success!";
}

try {
    print("Attempting unreliable operation...");
    let retry_result = unreliableOperation();
    print("Final result:", retry_result);
    print("✨ Unique: Built-in retry with backoff!\n");
} catch (e) {
    print("Failed after retries:", e);
}

// ============================================
// 6. Stacking Decorators
// ============================================
print("6. Stacking Multiple Decorators");
print("----------------------------------------");

@trace
@memoize  
@benchmark
fn stackedFunction(n) {
    return n * n;
}

print("First call:");
let s1 = stackedFunction(7);

print("\nSecond call (cached):");
let s2 = stackedFunction(7);
print("✨ Unique: Decorators compose automatically!\n");

// ============================================
// Summary
// ============================================
print("=== SUMMARY ===");
print("\nBuilt-in decorators provide UNIQUE capabilities:");
print("✅ @memoize  - Auto caching (performance boost)");
print("✅ @trace    - Auto logging with timing");
print("✅ @benchmark - Zero-overhead timing");
print("✅ @deprecated - Standardized warnings");
print("✅ @retry    - Built-in retry logic");
print("✅ Composable - Stack decorators together");
print("\n🎯 These features CAN'T be easily replicated");
print("   with regular functions - they have access");
print("   to runtime internals and optimized implementations!");
print("\n✨ The 'decorator' keyword is now JUSTIFIED!");
