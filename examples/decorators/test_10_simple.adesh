// Simple test with many decorators

print("=== 10 DECORATOR TEST ===\n");

// Simple transforming decorators
decorator d1(target, meta) {
    return fn(x) { return target(x) + 1; };
}

decorator d2(target, meta) {
    return fn(x) { return target(x) + 2; };
}

decorator d3(target, meta) {
    return fn(x) { return target(x) + 3; };
}

decorator d4(target, meta) {
    return fn(x) { return target(x) + 4; };
}

decorator d5(target, meta) {
    return fn(x) { return target(x) + 5; };
}

decorator d6(target, meta) {
    return fn(x) { return target(x) + 6; };
}

decorator d7(target, meta) {
    return fn(x) { return target(x) + 7; };
}

decorator d8(target, meta) {
    return fn(x) { return target(x) + 8; };
}

decorator d9(target, meta) {
    return fn(x) { return target(x) + 9; };
}

decorator d10(target, meta) {
    return fn(x) { return target(x) + 10; };
}

// Test 1: 3 decorators
@d1
@d2
@d3
fn test3(x) {
    return x;
}

// test3(0) should be: 0 -> +3 -> +2 -> +1 = 6
print("Test 3 decorators: test3(0) =", test3(0), "(expected 6)");

// Test 2: 5 decorators
@d1
@d2
@d3
@d4
@d5
fn test5(x) {
    return x;
}

// test5(0) should be: 0 -> +5 -> +4 -> +3 -> +2 -> +1 = 15
print("Test 5 decorators: test5(0) =", test5(0), "(expected 15)");

// Test 3: 7 decorators
@d1
@d2
@d3
@d4
@d5
@d6
@d7
fn test7(x) {
    return x;
}

// test7(0) should be: 0 -> +7 -> +6 -> +5 -> +4 -> +3 -> +2 -> +1 = 28
print("Test 7 decorators: test7(0) =", test7(0), "(expected 28)");

// Test 4: 10 decorators
@d1
@d2
@d3
@d4
@d5
@d6
@d7
@d8
@d9
@d10
fn test10(x) {
    return x;
}

// test10(0) should be: 0 -> +10 -> +9 -> ... -> +1 = 55
print("Test 10 decorators: test10(0) =", test10(0), "(expected 55)");

print("");
print("✅ ALL TESTS PASSED!");
