// Example 01: Basic Client Connection & Echo Protocol
// Demonstrates configuration, basic text sending/receiving, and close handshake.

import WebSocket;

fn runClient() {
    print("=== Example 01: Basic WebSocket Client ===");

    let server = WebSocket.server({ port: 8099, bind_address: "127.0.0.1" });
    server.startEcho();

    let config = WebSocket.ClientConfig({
        connect_timeout: 5000,
        idle_timeout: 30000
    });

    let client = WebSocket.connect("ws://127.0.0.1:8099", config);

    if (WebSocket.isError(client)) {
        print("Connection failed");
        return;
    }

    print("Connected successfully! State: " + client.getState().toString());

    let sendErr = client.sendText("Hello from AdeshLang!");
    if (WebSocket.isError(sendErr)) {
        print("Error sending message");
        return;
    }
    print("Sent text message: 'Hello from AdeshLang!'");

    let msg = client.receive();
    if (msg.type == "text") {
        print("Received Text: " + msg.payload);
    }

    client.close(1000, "Client shutting down");
    server.close();
    print("Client connection closed cleanly.");
}

runClient();
