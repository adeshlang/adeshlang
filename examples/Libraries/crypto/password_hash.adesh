// AdeshLang Cryptography Example: Password Hashing with Argon2id
import Crypto;

let userPassword = "MySecurePassword2026!";

print("Hashing password using Argon2id...");
let hash = Crypto.hashPassword(userPassword);
print("Argon2id Hash:", hash);

let isValid = Crypto.verifyPassword("MySecurePassword2026!", hash);
print("Password Verification Result:", isValid);

let isWrongValid = Crypto.verifyPassword("WrongPassword123", hash);
print("Wrong Password Verification Result:", isWrongValid);
