// 05 - Argon2id Memory-Hard Password Hashing & Verification
import Crypto;

let password = "SuperSecretPassword2026!";

print("Hashing password using Argon2id...");
let hash = Crypto.hashPassword(password);
print("Argon2id Hash:", hash);

let valid = Crypto.verifyPassword("SuperSecretPassword2026!", hash);
print("Password Match Verification:", valid);

let wrongValid = Crypto.verifyPassword("WrongPassword!", hash);
print("Wrong Password Verification:", wrongValid);
