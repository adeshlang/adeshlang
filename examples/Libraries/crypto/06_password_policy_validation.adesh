// 06 - Password Complexity & Policy Enforcement
import Crypto;

fn checkPolicy(pass) {
    if (len(pass) < 12) {
        return "Password must be at least 12 characters";
    }
    return "Valid Password";
}

print("Pass 1 ('short'):", checkPolicy("short"));
print("Pass 2 ('ValidPassphrase2026!'):", checkPolicy("ValidPassphrase2026!"));
