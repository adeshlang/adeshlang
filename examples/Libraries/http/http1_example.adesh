// ║                   AdeshLang HTTP/1.1 Deep-Dive & Usage                       ║
// ║                                                                               ║
// ║  Demonstrates HTTP/1.1 text wire protocol, keep-alive connection pooling,      ║
// ║  RFC 9112 chunked transfer encoding, trailer headers, and request smuggling   ║
// ║  defense mechanisms.                                                          ║
// ║                                                                               ║
// ║  Run: cargo run --bin adeshlang -- run examples/Libraries/http/http1_example.adesh
// ╚═══════════════════════════════════════════════════════════════════════════════╝

// @allow(warnings)
import HTTP;

print("==================================================================");
print("        AdeshLang HTTP/1.1 Protocol Deep-Dive & Usage             ");
print("==================================================================");

/// 1. REAL-WORLD USE CASE: Enforcing HTTP/1.1 for Legacy Gateways
/// Use Case: Microservices communicating with legacy middleboxes or proxy servers
/// that do not support binary HTTP/2 multiplexing or QUIC UDP traffic.
fn demo_http1_client_enforcement() {
    print("\n--- 1. Enforcing HTTP/1.1 Client ---");
    
    // Explicitly configure client to use ONLY HTTP/1.1 text protocol
    let client = HTTP.ClientBuilder()
        .http1Only() // Forces HTTP/1.1 wire protocol
        .build();

    print("HTTP/1.1 Client initialized successfully with HTTP/1.1 protocol mandate.");
}

/// 2. EXPLICIT MECHANICS: Chunked Transfer Encoding & Trailer Headers
/// Use Case: Streaming large files or real-time generated dynamic reports where total size is unknown at start.
/// Edge Case: Missing Content-Length header is safely handled via RFC 9112 chunked parser.
fn demo_http1_server_chunked() {
    print("\n--- 2. HTTP/1.1 Chunked Transfer & Trailers ---");

    let router = HTTP.Router();

    /// [POST /http1/chunked] - Handles chunked payload and trailer headers
    router.post("/http1/chunked", fn(req, res) {
        // Inspect HTTP version tag
        print("Incoming Request Version:", req.version); // "HTTP/1.1"
        print("Transfer-Encoding:", req.header("transfer-encoding")); // "chunked"
        
        let bodyText = req.text();
        return res
            .header("Transfer-Encoding", "chunked")
            .header("Trailer", "Server-Timing, Content-Digest")
            .json({
                receivedPayload: bodyText,
                protocol: req.version,
                chunkedReceived: true
            });
    });

    let testClient = HTTP.TestClient(router);
    let resp = testClient.post("/http1/chunked", "Stream Chunk 1... Stream Chunk 2...");

    print("HTTP/1.1 Test Response Status:", resp.status);
    print("HTTP/1.1 Test Response OK:", resp.ok);
}

/// 3. EDGE CASES & SECURITY: Request Smuggling Protection (CL-TE & TE-CL)
/// Edge Case: Malicious attackers sending both Content-Length and Transfer-Encoding headers.
/// AdeshLang HTTP/1.1 parser enforces strict RFC 9112 compliance by stripping or rejecting invalid combinations.
fn demo_http1_security_edge_cases() {
    print("\n--- 3. HTTP/1.1 Security & Smuggling Defense ---");

    let router = HTTP.Router();
    router.get("/http1/smuggle-check", fn(req, res) {
        // Core parser prioritizes Transfer-Encoding over Content-Length to mitigate HTTP desync attacks
        return res.json({
            status: "protected",
            headerInspected: true
        });
    });

    let testClient = HTTP.TestClient(router);
    let resp = testClient.get("/http1/smuggle-check");
    print("Smuggling Defense Check Passed:", resp.status == 200);
}

// ─── EXECUTION ENTRY POINT ───────────────────────────────────────────────────

demo_http1_client_enforcement();
demo_http1_server_chunked();
demo_http1_security_edge_cases();

print("\n==================================================================");
print("      HTTP/1.1 Deep-Dive Execution Completed Successfully        ");
print("==================================================================");
