// ╔═══════════════════════════════════════════════════════════════════════════════╗
// ║                   AdeshLang HTTP/3 Deep-Dive & Usage                         ║
// ║                                                                               ║
// ║  Demonstrates HTTP/3 QUIC UDP transport, QPACK out-of-order header           ║
// ║  compression, Alt-Svc protocol negotiation, H3 binary frame codec, and       ║
// ║  QUIC datagram streams.                                                      ║
// ║                                                                               ║
// ║  Run: cargo run --bin adeshlang -- run examples/Libraries/http/http3_example.adesh
// ╚═══════════════════════════════════════════════════════════════════════════════╝

// @allow(warnings)
import HTTP;

print("==================================================================");
print("        AdeshLang HTTP/3 Protocol Deep-Dive & Usage               ");
print("==================================================================");

/// 1. REAL-WORLD USE CASE: Enforcing HTTP/3 over QUIC Transport
/// Use Case: Mobile applications and edge deployments operating over lossy mobile networks (5G/LTE/Wi-Fi switches).
/// Edge Case: Prevents Head-of-Line blocking because packet loss on Stream A does NOT block Stream B!
fn demo_http3_client_enforcement() {
    print("\n--- 1. Enforcing HTTP/3 Client ---");

    // Configure client to prefer HTTP/3 over QUIC UDP, with automatic fallback
    let client = HTTP.ClientBuilder()
        .http3Preferred() // Enables HTTP/3 QUIC transport
        .profile("LowLatency") // Optimizes QUIC zero-RTT (0-RTT) handshake connection resumption
        .build();

    print("HTTP/3 Client initialized with QUIC transport & 0-RTT handshake preferences.");
}

/// 2. EXPLICIT MECHANICS: QPACK Compression & QUIC Stream IDs
/// Demonstrates QPACK out-of-order header compression (Encoder/Decoder stream + dynamic table)
/// and Variable-Length Integer (VLI) stream encoding.
fn demo_http3_mechanics() {
    print("\n--- 2. HTTP/3 QPACK & QUIC Stream Mechanics ---");

    let router = HTTP.Router();

    /// [GET /http3/quic-stream] - QUIC Bidirectional Stream Route
    router.get("/http3/quic-stream", fn(req, res) {
        return res
            .header("Alt-Svc", "h3=\":443\"; ma=86400") // Advertises HTTP/3 QUIC port to clients
            .json({
                protocol: "HTTP/3.0",
                quicTransport: true,
                qpackCompressed: true,
                altSvcHeader: "h3=\":443\"; ma=86400"
            });
    });

    let testClient = HTTP.TestClient(router);
    let resp = testClient.get("/http3/quic-stream");

    print("HTTP/3 Route Status:", resp.status);
    print("HTTP/3 Route Response Body:", resp.text());
}

/// 3. EDGE CASES & ADVANCED: Alt-Svc Discovery & QUIC Connection Migration
/// Edge Case: Smoothly handling network IP changes (e.g. Wi-Fi to Cellular data) via QUIC connection IDs.
/// Edge Case: Fallback to HTTP/2 if UDP port 443 is blocked by corporate firewalls.
fn demo_http3_edge_cases() {
    print("\n--- 3. HTTP/3 Alt-Svc & Firewall Fallback ---");

    // Perform capability discovery scan
    let disc = HTTP.discover("http://localhost:4000");

    print("Discovered HTTP/3 (QUIC) support:", disc.http3);
    print("Discovered WebTransport support:", disc.websocket);
}

// ─── EXECUTION ENTRY POINT ───────────────────────────────────────────────────

demo_http3_client_enforcement();
demo_http3_mechanics();
demo_http3_edge_cases();

print("\n==================================================================");
print("      HTTP/3 Deep-Dive Execution Completed Successfully          ");
print("==================================================================");
