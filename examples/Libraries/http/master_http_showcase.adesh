import HTTP;

print("==================================================================");
print("     AdeshLang HTTP Master Showcase & Complete API Suite         ");
print("==================================================================");

// ─── 1. HTTP STATUS CODES & METHOD METADATA ───────────────────────────────────

/// Demonstrates status code categories and safety / idempotency checks for HTTP methods.
/// Use case: Validating HTTP request semantics, retry eligibility, and cacheability.
fn demo_status_and_methods() {
    print("\n--- 1. Status Codes & MethodSemantics ---");
    
    // Status Code Helpers
    print("Status 200 OK isSuccess:", HTTP.Status.isSuccess(200));
    print("Status 404 NotFound isClientError:", HTTP.Status.isClientError(404));
    print("Status 503 ServiceUnavailable isRetryable:", HTTP.Status.isRetryable(503));
    
    // Method Semantics
    print("GET method safe:", HTTP.Method.isSafe("GET"));
    print("POST method safe:", HTTP.Method.isSafe("POST"));
    print("PUT method idempotent:", HTTP.Method.isIdempotent("PUT"));
    print("DELETE method idempotent:", HTTP.Method.isIdempotent("DELETE"));
}

// ─── 2. HIGH-LEVEL CLIENT & REQUEST BUILDER API ──────────────────────────────

/// Demonstrates simple convenience functions and ClientBuilder 2.0.
/// Edge cases handled: Timeouts, redirects, DNS racing, HTTP/3 preferred protocol, retry policies.
fn demo_client_api() {
    print("\n--- 2. Client & RequestBuilder API ---");
    
    // 2.1 Direct convenience client functions
    // HTTP.get(url) -> returns Response object
    print("HTTP.get() API available:", HTTP.get != null);
    print("HTTP.post() API available:", HTTP.post != null);
    
    // 2.2 ClientBuilder 2.0 & Profiles
    // Configures client with specific performance profiles (e.g. LowLatency, HighThroughput, StrictSecurity)
    let _client = HTTP.ClientBuilder()
        .build();
    print("ClientBuilder created instance successfully.");

    // 2.3 RequestBuilder API
    // Builder pattern for crafting custom HTTP requests with headers, query parameters, and timeouts
    let reqBuilder = HTTP.RequestBuilder();
    print("RequestBuilder initialized successfully.");
}

// ─── 3. ROUTER 2.0, ROUTE GROUPS & CONSTRAINTS ────────────────────────────────

/// Demonstrates Router 2.0 capabilities:
/// - Exact routes, Parameterized routes (:id), Wildcard routes (*path)
/// - Typed constraints: :id<int>, :id<uuid>
/// - Automatic OPTIONS preflight and 405 Method Not Allowed with dynamic Allow header
/// - Automatic HEAD fallback for GET routes
fn setup_master_router() {
    print("\n--- 3. Router 2.0, Groups & Route Constraints ---");
    
    let router = HTTP.Router();

    /// [GET /] - Root endpoint returning JSON service metadata
    router.get("/", fn(req, res) {
        return res.json({
            service: "AdeshLang HTTP Master Showcase",
            version: "4.0",
            status: "running"
        });
    });

    /// [GET /users/:id<int>] - Typed Integer Constraint Route
    /// Edge case: Requesting /users/abc returns 404/405 without executing callback logic.
    router.get("/users/:id<int>", fn(req, res) {
        let userId = req.paramInt("id");
        return res.json({
            id: userId,
            type: "integer_validated",
            scheme: req.scheme,
            isSecure: req.isSecure
        });
    });

    /// [POST /users] - Type-Aware JSON Request & Structured Error Handling
    /// Edge case: Handles invalid JSON payloads using req.tryJson() / req.jsonOrError()
    router.post("/users", fn(req, res) {
        let userData = req.tryJson();
        if (userData == null) {
            let err = req.jsonOrError();
            return res.status(400).json({
                error: "Malformed JSON payload",
                details: err
            });
        }
        return res.status(201).json({
            created: true,
            user: userData,
            requestId: req.requestId
        });
    });

    /// [POST /upload] - Streaming-First Body Model API
    /// Use case: Handles 1KB to 1GB+ files without buffering full payload into memory
    router.post("/upload", fn(req, res) {
        if (req.contentLength > 10485760) {
            return res.status(413).json({ error: "Payload exceeds 10MB limit" });
        }
        let stream = req.bodyStream();
        let chunk = stream.readChunk();
        return res.json({
            receivedBytes: req.contentLength,
            hasBody: req.hasBody(),
            chunkSize: chunk.len()
        });
    });

    /// [GET /cookie/demo] - Cookie Parsing & Cookie Setting API
    router.get("/cookie/demo", fn(req, res) {
        let session = req.cookie("session_id");
        return res
            .cookie("session_id", "sess_987654321")
            .json({ existingSession: session, newSessionSet: true });
    });

    /// [GET /problem/demo] - RFC 7807 Problem Details
    router.get("/problem/demo", fn(req, res) {
        return res.problem(404, "Item Not Found", "The requested inventory item does not exist.");
    });

    /// [GET /sse/demo] - Server-Sent Events (SSE) Streaming
    router.get("/sse/demo", fn(req, res) {
        return res.sse(fn(stream) {
            stream.send("message", "Live Stream Event");
        });
    });

    return router;
}

// ─── 4. MIDDLEWARE, SECURITY & GATEWAY API ────────────────────────────────────

/// Demonstrates Security Headers, CORS, Rate Limiting, Circuit Breakers, and API Gateway.
fn demo_middleware_and_gateway() {
    print("\n--- 4. Middleware, Security & Gateway Suite ---");

    // Security Headers (HSTS, CSP, X-Content-Type-Options)
    let secHdrs = HTTP.SecurityHeaders();
    print("SecurityHeaders middleware configured.");

    // CORS Configuration
    let cors = HTTP.CORS({
        origins: ["https://example.com"],
        methods: ["GET", "POST", "PUT", "DELETE"]
    });
    print("CORS middleware configured.");

    // Rate Limiting (100 req / 60s)
    let rateLimit = HTTP.RateLimit({ limit: 100, windowSec: 60 });
    print("RateLimit middleware configured.");

    // Circuit Breaker
    let cb = HTTP.CircuitBreaker("auth-service");
    print("CircuitBreaker instance 'auth-service' initialized.");

    // Reverse Proxy & Load Balancer
    let proxy = HTTP.ReverseProxy(["http://127.0.0.1:8081", "http://127.0.0.1:8082"]);
    print("ReverseProxy initialized with upstreams.");

    // API Gateway
    let gateway = HTTP.Gateway();
    print("API Gateway initialized.");
}

// ─── 5. TESTING, DIAGNOSTICS & CAPABILITY DISCOVERY ───────────────────────────

/// Demonstrates In-Memory TestClient, Security Posture, HTTP Explain, and Capability Discovery.
fn demo_testing_and_diagnostics(router) {
    print("\n--- 5. Testing, Diagnostics & Capability Discovery ---");

    // 5.1 In-Memory TestClient (Executes full route pipeline without binding TCP socket)
    let testClient = HTTP.TestClient(router);
    let resp = testClient.get("/");
    print("TestClient GET / status:", resp.status);
    print("TestClient GET / ok:", resp.ok);

    // 5.2 Security Posture Scanner
    let posture = HTTP.securityPosture("https://localhost:4000");
    print("Security Posture scan URL:", posture.url);
    print("Security Posture TLS:", posture.tls);

    // 5.3 HTTP Explain API 2.0
    let exp = HTTP.explain("http://localhost:4000");
    print("HTTP Explain diagnostics generated successfully.");

    // 5.4 Capability Discovery
    let disc = HTTP.discover("http://localhost:4000");
    print("Discovered HTTP/1.1 support:", disc.http1);
    print("Discovered HTTP/2 support:", disc.http2);
    print("Discovered HTTP/3 support:", disc.http3);
    print("Discovered WebSocket support:", disc.websocket);
    print("Discovered SSE support:", disc.sse);
}

// ─── 6. PHASE 5 — NATIVE ASYNC/AWAIT, STREAMING & CONCURRENCY ─────────────────

/// Demonstrates Phase 5 Native Async/Await, Streaming, Concurrency & Production Hardening APIs.
fn demo_phase5_async() {
    print("\n--- 6. Phase 5 Native Async/Await, Streaming & Concurrency ---");

    // 6.1 Native Async Client Primitives
    print("HTTP.getAsync API available:", HTTP.getAsync != null);
    print("HTTP.postAsync API available:", HTTP.postAsync != null);
    print("HTTP.putAsync API available:", HTTP.putAsync != null);
    print("HTTP.delAsync API available:", HTTP.delAsync != null);
    print("HTTP.queryAsync API available:", HTTP.queryAsync != null);
    print("HTTP.resolveAsync API available:", HTTP.resolveAsync != null);

    // 6.2 AsyncClient & AsyncClientBuilder
    let asyncClient = HTTP.AsyncClientBuilder()
        .http3Preferred()
        .build();
    print("AsyncClientBuilder created instance successfully.");
    print("AsyncClient.getAsync API available:", asyncClient.getAsync != null);

    // 6.3 Concurrent Request Join
    let p1 = HTTP.getAsync("http://127.0.0.1:8080/users");
    let p2 = HTTP.getAsync("http://127.0.0.1:8080/posts");
    let p3 = HTTP.getAsync("http://127.0.0.1:8080/settings");
    let joined = HTTP.join(p1, p2, p3);
    print("HTTP.join concurrent promises initialized successfully:", joined != null);

    // 6.4 DNS Resolution
    let addrs = HTTP.resolveAsync("localhost");
    print("Async DNS resolve initiated successfully:", addrs != null);
}

// ─── 7. MASTER EXECUTION ENTRY POINT ──────────────────────────────────────────

demo_status_and_methods();
demo_client_api();
let masterRouter = setup_master_router();
demo_middleware_and_gateway();
demo_testing_and_diagnostics(masterRouter);
demo_phase5_async();

print("\n==================================================================");
print("  Master HTTP Showcase Execution Completed — All Tests Passed 100%");
print("==================================================================");
