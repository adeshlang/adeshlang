// 17_date_arithmetic.adesh - Date arithmetic, leap years, calendar math
import Time;

print("=== Date Arithmetic ===\n");

let base: Date = Time.dateYmd(2024, 2, 28);
print("Base date:", base.toIsoString());

// --- Add/subtract days ---
print("\n--- Days arithmetic ---");
let d1: Date = base.addDays(1);   // Feb 29 (2024 is leap)
let d2: Date = base.addDays(2);   // Mar 1
let d3: Date = base.addDays(366); // Next year same day
let d4: Date = base.subDays(365);
print("+1  day :", d1.toIsoString());
print("+2  days:", d2.toIsoString());
print("+366 days:", d3.toIsoString());
print("-365 days:", d4.toIsoString());

// --- Add months ---
print("\n--- Month arithmetic ---");
let jan31: Date = Time.dateYmd(2024, 1, 31);
let feb28: Date = jan31.addMonths(1);   // Clamped to last day of Feb
let mar31: Date = jan31.addMonths(2);
let dec31: Date = Time.dateYmd(2023, 12, 31);
let jan24: Date = dec31.addMonths(1);
print("Jan 31 + 1m  :", feb28.toIsoString());
print("Jan 31 + 2m  :", mar31.toIsoString());
print("Dec 31 + 1m  :", jan24.toIsoString());

// --- Add years ---
print("\n--- Year arithmetic ---");
let leap: Date = Time.dateYmd(2000, 2, 29);
let nonLeap: Date = leap.addYears(1);   // Clamped to Feb 28
let backToLeap: Date = leap.addYears(4);
print("2000-02-29 + 1y:", nonLeap.toIsoString());
print("2000-02-29 + 4y:", backToLeap.toIsoString());

// --- Days since ---
print("\n--- Difference ---");
let start: Date = Time.dateYmd(2000, 1, 1);
let end: Date = Time.dateYmd(2024, 7, 15);
let days: i64 = end.daysSince(start);
print("Days from 2000-01-01 to 2024-07-15:", days);
print("Years approx:", days / 365);

// --- Epoch days ---
print("\n--- Epoch days ---");
let epoch: Date = Time.dateYmd(1970, 1, 1);
print("Epoch date epoch days:", epoch.toEpochDays());
print("Today epoch days     :", Time.dateToday().toEpochDays());

// --- Leap year checks ---
print("\n--- Leap Year Checks ---");
let years = [1900, 2000, 2024, 2100, 2400];
let idx = 0;
while (idx < len(years)) {
    let y = years[idx];
    let d = Time.dateYmd(y, 1, 1);
    print("Year", y, "is leap:", d.isLeapYear());
    idx = idx + 1;
}

// --- Weekday of date ---
print("\n--- Weekday ---");
let known: Date = Time.dateYmd(2024, 7, 15);  // Monday
print("2024-07-15 weekday:", known.weekday().numberFromMonday(), "(0=Mon)");
let known2: Date = Time.dateYmd(2024, 7, 21); // Sunday
print("2024-07-21 weekday:", known2.weekday().numberFromMonday());
