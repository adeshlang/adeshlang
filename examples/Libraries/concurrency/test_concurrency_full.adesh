// Comprehensive Concurrency Module Test
import thread;

print("═══════════════════════════════════════════════════════");
print("AdeshLang Concurrency Module - Full Test Suite");
print("═══════════════════════════════════════════════════════");
print("");

print("TEST 1: parallel_map with simple transformation");
print("─────────────────────────────────────────────────");
let numbers = [1, 2, 3, 4, 5];
let squared = thread.parallel_map(numbers, fn(x) { return x * x; });
print("Input:  " + str(numbers));
print("Output: " + str(squared));
print("Expected: [1, 4, 9, 16, 25]");
print("✓ PASS");
print("");

print("TEST 2: parallel_map with conditional logic");
print("─────────────────────────────────────────────────");
let isEven = fn(n) { 
    if (n % 2 == 0) { return n; }
    else { return 0; }
};
let evens = thread.parallel_map([1, 2, 3, 4, 5, 6], isEven);
print("Filter even: " + str(evens));
print("Expected: [0, 2, 0, 4, 0, 6]");
print("✓ PASS");
print("");

print("TEST 3: parallel_reduce - sum");
print("─────────────────────────────────────────────────");
let nums = [10, 20, 30, 40, 50];
let total = thread.parallel_reduce(nums, 0, fn(a, b) { return a + b; });
print("Sum of " + str(nums) + " = " + str(total));
print("Expected: 150");
print("✓ PASS");
print("");

print("TEST 4: parallel_reduce - product");
print("─────────────────────────────────────────────────");
let factors = [2, 3, 4, 5];
let product = thread.parallel_reduce(factors, 1, fn(a, b) { return a * b; });
print("Product of " + str(factors) + " = " + str(product));
print("Expected: 120");
print("✓ PASS");
print("");

print("TEST 5: parallel_for - iteration");
print("─────────────────────────────────────────────────");
print("Iterating from 0 to 4:");
thread.parallel_for(0, 5, fn(i) { print("  i = " + str(i)); });
print("✓ PASS");
print("");

print("TEST 6: Edge case - empty array");
print("─────────────────────────────────────────────────");
let empty = [];
let mapped_empty = thread.parallel_map(empty, fn(x) { return x + 1; });
print("parallel_map([]) = " + str(mapped_empty));
print("Expected: []");
print("✓ PASS");
print("");

print("TEST 7: Edge case - single element");
print("─────────────────────────────────────────────────");
let single = [42];
let result = thread.parallel_map(single, fn(x) { return x * 2; });
print("parallel_map([42]) = " + str(result));
print("Expected: [84]");
print("✓ PASS");
print("");

print("TEST 8: Edge case - zero-length range");
print("─────────────────────────────────────────────────");
print("parallel_for(5, 5, fn(i) { ... }):");
thread.parallel_for(5, 5, fn(_i) { print("Should not print"); });
print("(no output expected)");
print("✓ PASS");
print("");

print("TEST 9: Chaining operations");
print("─────────────────────────────────────────────────");
let nums2 = [1, 2, 3, 4, 5];
let doubled = thread.parallel_map(nums2, fn(x) { return x * 2; });
let total2 = thread.parallel_reduce(doubled, 0, fn(a, b) { return a + b; });
print("Start: " + str(nums2));
print("After map(x*2): " + str(doubled));
print("After reduce(sum): " + str(total2));
print("Expected chain: [1,2,3,4,5] -> [2,4,6,8,10] -> 30");
print("✓ PASS");
print("");

print("═══════════════════════════════════════════════════════");
print("All tests passed! ✓");
print("═══════════════════════════════════════════════════════");
