// Production-style order ingest pipeline.
//
// Exercises the import-only `thread` API together with language features used
// across examples/: types, enums, classes, match, tuples, arrays, objects,
// interpolation, while/for, clock, Result-style {ok,value}.
//
// Live phase is ~2 seconds (4 × 500 ms ticks) so you can inspect native OS threads:
//   Task Manager → Details → adeshlang.exe → right-click → Analyze wait chain
//   or Resource Monitor → CPU → Threads (filter adeshlang)
//
// Full write-up: examples/concurrency/PRODUCTION.md
//
// Run:  adeshlang run examples/concurrency/production_order_pipeline.adesh --interpreter --timeout 20s

import thread;

thread.watchdog(30000);

const RUN_MS = 2000;
const TICK_MS = 500;
const PRODUCERS = 3;
const PIPELINE_WORKERS = 2;

enum Stage {
    Ingress,
    Compute,
    Flush
}

enum Priority {
    Low,
    Normal,
    High
}

class PipelineReport {
    PipelineReport(n) {
        this.cpus = n;
        this.pool_size = n;
        this.started = clock();
    }

    fn expected_os_threads() {
        return 1 + this.pool_size + PRODUCERS + PIPELINE_WORKERS + 2;
    }

    fn elapsed() {
        return clock() - this.started;
    }

    fn banner() {
        print("╔══════════════════════════════════════════════════════════╗");
        print("║  PRODUCTION ORDER PIPELINE — live OS thread soak         ║");
        print("╚══════════════════════════════════════════════════════════╝");
        print(`  logical CPUs:     ${this.cpus}`);
        print(`  pool workers:     ${this.pool_size}`);
        print(`  named extras:     ${PRODUCERS} ingress + ${PIPELINE_WORKERS} pipeline + heartbeat + flusher`);
        print(`  expected ~threads ${this.expected_os_threads()} (plus a few runtime helpers)`);
        print(`  duration:         ${RUN_MS} ms — watch Task Manager / Resource Monitor now`);
        print("");
    }
}

fn stage_name(st) {
    if (st.tag == "Ingress") {
        return "ingress";
    } elif (st.tag == "Compute") {
        return "compute";
    } elif (st.tag == "Flush") {
        return "flush";
    }
    return "unknown";
}

fn priority_weight(p) {
    if (p.tag == "High") {
        return 3;
    } elif (p.tag == "Normal") {
        return 2;
    }
    return 1;
}

fn make_job(id, payload, kind, pr) {
    return {
        id: id,
        payload: payload,
        kind: kind,
        priority: pr
    };
}

fn score_job(payload, id, priority) {
    let w = 1;
    if (priority == "high") {
        w = 3;
    } elif (priority == "normal") {
        w = 2;
    }
    return payload * 17 + id + w;
}

fn format_thread_row(row) {
    let n = row.name;
    if (n == null) {
        n = "(unnamed)";
    }
    return `    id=${row.id}  ${n}`;
}

fn print_live_threads(label) {
    let listed = thread.list();
    print(`-- ${label}  registry=${listed.len()}  time=${clock()}`);
    let i = 0;
    while i < listed.len() {
        print(format_thread_row(listed[i]));
        i = i + 1;
    }
}

thread.name("adesh-main");
let report = new PipelineReport(thread.hardware_concurrency());
let pool_n = report.pool_size;
if (pool_n < 2) {
    pool_n = 2;
}
report.banner();

let once_log = thread.Once.new();
once_log.call_once(fn() {
    print("once: logging subsystem initialized");
    return 1;
});
let lazy_cpus = thread.Lazy.new(fn() { return thread.hardware_concurrency(); });
print(`lazy hardware_concurrency cache: ${lazy_cpus.get()}`);
print(`stages ${stage_name(Stage.Ingress())} / ${stage_name(Stage.Compute())} / ${stage_name(Stage.Flush())}`);

let cfg = thread.RwLock.new({
    batch: 8,
    enabled: true
});
let metrics = thread.Mutex.new({
    ingested: 0,
    computed: 0,
    flushed: 0,
    overflow: 0
});
let ingested = thread.Atomic.AtomicI64.new(0);
let computed = thread.Atomic.AtomicI64.new(0);
let accepted = thread.Atomic.AtomicBool.new(true);
let slots = thread.Semaphore.new(4);
let ready = thread.CountDownLatch.new(PRODUCERS + PIPELINE_WORKERS + 2);
let start_bar = thread.Barrier.new(PRODUCERS + PIPELINE_WORKERS + 2);
let wg = thread.WaitGroup.new();
let cancel_src = thread.CancellationSource.new();
let token = cancel_src.token();
let batch_ev = thread.Condvar.new();
let tls = thread.ThreadLocal.new("unset");
let overflow = thread.ConcurrentQueue.new();
let pool = thread.ThreadPool.new(pool_n);

let ingress = thread.Channel.bounded(32);
let tx_in = ingress[0];
let rx_in = ingress[1];
let compute_ch = thread.Channel.bounded(32);
let tx_cmp = compute_ch[0];
let rx_cmp = compute_ch[1];

wg.add(PRODUCERS + PIPELINE_WORKERS + 2);

let p = 0;
let ingress_handles = [];
while p < PRODUCERS {
    let pid = p;
    let tx = tx_in.clone();
    ingress_handles.push(thread.spawn_named(`ingress-${pid}`, fn() {
        tls.set(`ingress-${pid}`);
        start_bar.wait();
        ready.count_down();
        let seq = 0;
        let job = make_job(0, 0, "ingress", "normal");
        let sent = { ok: false, value: null };
        while !token.is_cancelled() {
            let jid = pid * 100000 + seq;
            let jpayload = seq * (pid + 1);
            job = make_job(jid, jpayload, "ingress", "normal");
            sent = tx.try_send(job);
            if (sent.ok) {
                ingested.fetch_add(1, "Relaxed");
            } else {
                overflow.push(make_job(jid, jpayload, "ingress", "normal"));
            }
            seq = seq + 1;
            thread.sleep(8);
        }
        wg.done();
        return seq;
    }));
    p = p + 1;
}

let w = 0;
let pipeline_handles = [];
while w < PIPELINE_WORKERS {
    let wid = w;
    let rx = rx_in.clone();
    let tx = tx_cmp.clone();
    pipeline_handles.push(thread.spawn_named(`pipeline-${wid}`, fn() {
        tls.set(`pipeline-${wid}`);
        start_bar.wait();
        ready.count_down();
        let n = 0;
        let msg = rx.try_recv();
        let job = make_job(0, 0, "ingress", "normal");
        let s = 0;
        while !token.is_cancelled() {
            msg = rx.recv_timeout(50);
            if (msg.ok) {
                job = msg.value;
                let jid = job.id;
                s = score_job(job.payload, jid, job.priority);
                pool.execute(fn() {
                    let x = s;
                    x = (x * 1103515245 + 12345) % 2147483647;
                    computed.fetch_add(1, "Relaxed");
                });
                tx.try_send({ id: jid, score: s });
                n = n + 1;
                if (n % 16 == 0) {
                    batch_ev.notify_one();
                }
            }
            thread.yield();
        }
        wg.done();
        return n;
    }));
    w = w + 1;
}

let heartbeat = thread.builder().name("heartbeat").spawn(fn() {
    tls.set("heartbeat");
    start_bar.wait();
    ready.count_down();
    while !token.is_cancelled() {
        thread.sleep(80);
    }
    wg.done();
    return thread.id();
});

let flusher = thread.spawn_named("flusher", fn() {
    tls.set("flusher");
    start_bar.wait();
    ready.count_down();
    let flushed = 0;
    let msg = rx_cmp.try_recv();
    let ovs = { ok: false, value: null };
    while !token.is_cancelled() {
        batch_ev.wait_timeout(120);
        batch_ev.reset();
        msg = rx_cmp.try_recv();
        while msg.ok {
            flushed = flushed + 1;
            metrics.with(fn(m) {
                m.flushed = m.flushed + 1;
                return m;
            });
            msg = rx_cmp.try_recv();
        }
        ovs = overflow.pop();
        if (ovs.ok) {
            flushed = flushed + 1;
            metrics.with(fn(m) {
                m.overflow = m.overflow + 1;
                return m;
            });
        }
    }
    wg.done();
    return flushed;
});

print("waiting for workers to pass the startup barrier / latch...");
let ready_ok = ready.wait_timeout(5000);
if (!ready_ok) {
    print("startup latch timed out — cancelling");
    cancel_src.cancel();
}

print_live_threads("after startup (stable set — start native sampling now)");
print(`current = ${thread.current().id} name=${thread.current().name}`);
print(`pool.size=${pool.size()}  sem.permits=${slots.available_permits()}  once=${once_log.is_completed()}`);
print("");

let total_ticks = 4;
let ticks = 0;
while ticks < total_ticks {
    ticks = ticks + 1;
    let ing = ingested.load("Relaxed");
    let cmp = computed.load("Relaxed");
    print(`tick ${ticks}  ingested=${ing}  pool_compute=${cmp}`);
    thread.sleep(TICK_MS);
}

print("");
print("shutting down: cancel → close channels → waitgroup → pool...");
cancel_src.cancel();
tx_in.close();
tx_cmp.close();
batch_ev.notify_all();
heartbeat.unpark();

print("waiting for wg.wait_timeout...");
let wg_ok = wg.wait_timeout(5000);
print(`wg.wait_timeout ok=${wg_ok}`);
let ht = heartbeat.join_timeout(2000);
print(`heartbeat join_timeout=${ht}`);

let ip = 0;
while ip < ingress_handles.len() {
    print(`joining ingress ${ip}...`);
    let jr = ingress_handles[ip].join_timeout(2000);
    if (jr != null && jr.ok == false) {
        print(`ingress ${ip} join timed out`);
    }
    ip = ip + 1;
}
let pw = 0;
while pw < pipeline_handles.len() {
    print(`joining pipeline ${pw}...`);
    let pr = pipeline_handles[pw].join_timeout(2000);
    if (pr != null && pr.ok == false) {
        print(`pipeline ${pw} join timed out`);
    }
    pw = pw + 1;
}
if (flusher.is_finished()) {
    print("flusher already finished");
}
print("joining flusher...");
let fj = flusher.join_timeout(2000);
if (fj != null && fj.ok == false) {
    print("flusher join timed out");
}

print("shutting down pool...");
pool.shutdown();
print("joining pool...");
let pj = pool.join_timeout(3000);
print(`pool.join_timeout=${pj}`);

print_live_threads("after join (pool workers should be gone)");
let final_m = metrics.lock();
if (final_m.ok) {
    let v = final_m.value.get();
    print(`final mutex metrics ingested=${v.ingested} flushed=${v.flushed} overflow=${v.overflow}`);
    final_m.value.unlock();
}
print(`final atomics ingested=${ingested.load("SeqCst")} computed=${computed.load("SeqCst")}`);
print(`elapsed ${report.elapsed()}s  ticks=${ticks}`);
print("pipeline complete.");
thread.disarm_watchdog();
