import Random;

print("--- Weighted Choice Demo ---");
let items = ["Common Sword", "Rare Shield", "Legendary Armor"];
let weights = [80.0, 19.0, 1.0];

let loot = Random.weightedChoice(items, weights);
print("Sampled loot: " + loot);

let lootFromPairs = Random.weightedChoice([
    ["Silver Coin", 70.0],
    ["Gold Coin", 25.0],
    ["Diamond", 5.0]
]);
print("Sampled loot from pairs: " + lootFromPairs);
