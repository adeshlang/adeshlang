import URL;

let tmpl: URLTemplate = URL.template("https://api.example.com/v1/projects/{projectId}/issues/{issueId}");
let expandedUrl: URL = tmpl.expand({
    "projectId": "adesh-lang",
    "issueId": "104"
});

print("--- 09 Template Expansion Example ---");
print("Expanded Href:", expandedUrl.href);
