import URL;

let rawUrlStr: String = "https://user:pass123@api.example.com:8443/v1/users?page=2&limit=50#active";
let url: URL = URL.parse(rawUrlStr);

let scheme: String = url.scheme;
let host: String = url.host;
let port: Option<Int> = url.port;
let path: String = url.path;
let query: String = url.query;
let redactedStr: String = url.redacted();

print("--- 01 Basic Parsing Example ---");
print("Scheme:", scheme);
print("Host:", host);
print("Port:", port);
print("Path:", path);
print("Query:", query);
print("Redacted String:", redactedStr);
