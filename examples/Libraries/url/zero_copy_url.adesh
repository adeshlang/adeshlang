import URL;

let rawString: String = "https://example.com:8080/api/v1?user=1#top";
let view: URLView = URL.parseView(rawString);

print("View Scheme:", view.scheme);
print("View Host:", view.host);
print("View Path:", view.path);

let ownedUrl: URL = view.toOwned();
print("Owned URL Href:", ownedUrl.href);
