// Phase 3 Example: Fully Type-Annotated TLS Client
import TLS;

let host: String = "1.1.1.1";
let port: i64 = 443;

print("--- Establishing Strongly Typed TLS 1.3 Connection ---");

let options: Object = {
    "verifyCertificates": true,
    "verifyHostname": true,
    "minVersion": "TLS1.3",
    "alpn": ["http/1.1"]
};

let tls: TLS = TLS.connectWithOptions(host, port, options);

let ver: String = tls.version();
let alpn: String = tls.alpn();

print("Protocol Version: " + ver);
print("Negotiated ALPN: " + (alpn == "" ? "None" : alpn));

let requestText: String = "GET / HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n";
let bytesWritten: i64 = tls.writeText(requestText);
print("Bytes Transmitted: " + bytesWritten);

let responseText: String = tls.readText(1024);
print("\nReceived Response Text:\n" + responseText);

tls.close();
print("Typed TLS Client Session Terminated Cleanly.");
