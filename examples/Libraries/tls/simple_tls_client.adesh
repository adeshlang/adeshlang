// Example 1: Simple TLS HTTPS Request to a Public Host
import TLS;

let host = "1.1.1.1";
let port = 443;

print("Connecting to " + host + ":" + port + " via TLS 1.3...");
let handle = TLS.connect(host, port);

let request = "GET / HTTP/1.1\r\nHost: " + host + "\r\nUser-Agent: AdeshLang-TLS\r\nConnection: close\r\n\r\n";
TLS.write(handle, request);

let version = TLS.version(handle);
let alpn = TLS.alpn(handle);
print("Negotiated Protocol: " + version);
print("Negotiated ALPN: " + alpn);

let response = TLS.read(handle, 4096);
print("\n--- Response Header Snippet ---");
print(response);

TLS.close(handle);
print("Connection gracefully closed.");
