print(("========================================"));
import Collections;

let vect = Collections.Vec<u8>();

vect.push(100);  // OK: valid u8
vect.push(200);  // OK: valid u8
vect.push(255);  // OK: valid u8
print("Vector content: ", vect.toArray());
print("Vector first: ", vect.first());
print("Vector last: ", vect.last());
print("Popped value: ", vect.pop());
print("Vector final len: ", vect.len());