import Collections;

print("========================================");
print("Breadth-First Search (BFS) Example");
print("========================================");

let adj = Collections.HashMap();

fn add_edge(adj, u, v) {
    let list = adj.get(u);
    if (list == null) {
        list = Collections.Vec();
        adj.insert(u, list);
    }
    list.push(v);
}

add_edge(adj, "1", "2");
add_edge(adj, "1", "3");
add_edge(adj, "2", "4");
add_edge(adj, "3", "5");

let q = Collections.Queue();
let visited = Collections.HashSet();

q.enqueue("1");
visited.insert("1");

print("BFS Order:");
while (!q.isEmpty()) {
    let curr = q.dequeue();
    print("Visited: ", curr);
    let neighbors = adj.get(curr);
    if (neighbors != null) {
        for nbr in neighbors.toArray() {
            if (!visited.contains(nbr)) {
                visited.insert(nbr);
                q.enqueue(nbr);
            }
        }
    }
}
