// Numeric Literals & Type Introspection Tests
// Covers binary/hex/underscore literals, f32/f64 width inference,
// and the `type` / `typeof` / `sizeof` builtins from examples/types.

// ─────────────────────────────────────────────────────────────
// Helpers (self-contained, pure)
// ─────────────────────────────────────────────────────────────

export fn binary_literal(): i32 {
    return 0b1010;
}

export fn hex_literal(): i32 {
    return 0xFF;
}

export fn underscore_literal(): i32 {
    return 1_000_000;
}

export fn literal_arithmetic_sum(): i32 {
    return 0b1010 + 0xFF + 1_000_000;
}

export fn f32_width(): i32 {
    let f32_value: f32 = 3.14f32;
    return sizeof(f32_value);
}

export fn f64_width(): i32 {
    let f64_value: f64 = 3.141592653589793f64;
    return sizeof(f64_value);
}

export fn is_same_type(a, b): bool {
    return type(a) == type(b);
}

export fn big_hex_value(): i32 {
    return 0xDEAD + 0xBEEF;
}

// ─────────────────────────────────────────────────────────────
// Test Cases
// ─────────────────────────────────────────────────────────────

export test fn test_binary_literal() {
    assert_eq(binary_literal(), 10);
    assert_eq(binary_literal(), 0b1010);
    assert_ne(binary_literal(), 11);
}

export test fn test_hex_literal() {
    assert_eq(hex_literal(), 255);
    assert_eq(hex_literal(), 0xFF);
    assert_eq(big_hex_value(), 57005 + 48879);
}

export test fn test_underscore_separators() {
    assert_eq(underscore_literal(), 1000000);
    assert_eq(1_2_3, 123);
}

export test fn test_literal_arithmetic() {
    assert_eq(literal_arithmetic_sum(), 10 + 255 + 1000000);
    assert_eq(0b1111 + 1, 16);
    assert_eq(0x10 * 2, 32);
}

export test fn test_float_widths() {
    let f32_value: f32 = 3.14f32;
    let f64_value: f64 = 3.141592653589793f64;
    assert_eq(type(f32_value), "f32");
    assert_eq(type(f64_value), "f64");
    assert_eq(f32_width(), 4);
    assert_eq(f64_width(), 8);
}

export test fn test_type_introspection() {
    assert_eq(type(42), typeof(42));
    assert_eq(type(3.5), typeof(3.5));
    assert_eq(type("hello"), "string");
    assert_eq(type(true), "boolean");
    assert_eq(type([1, 2]), type([3]));
    assert_eq(is_same_type(1, 2), true);
    assert_eq(is_same_type("a", 1), false);
}

// ─────────────────────────────────────────────────────────────
// Programmatic test suite runner for main.adesh integration
// ─────────────────────────────────────────────────────────────

export fn run_tests() {
    test_binary_literal();
    test_hex_literal();
    test_underscore_separators();
    test_literal_arithmetic();
    test_float_widths();
    test_type_introspection();
    return 6;
}

fn main() {
    print("Running 01_numeric_literals tests...");
    let count = run_tests();
    print(`Passed ${count} tests in 01_numeric_literals.test.adesh`);
}
