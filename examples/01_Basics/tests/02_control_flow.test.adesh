// Control-Flow & Loop Tests
// Covers examples/01_Basics/loops.adesh:
//   - classic C-style 3-part for loop
//   - multi-variable C-style for loop
//   - for loop with continue (post-expression still runs)
//   - guaranteed-execution do-while loop
//   - do-while loop with continue and condition evaluation
//   - collection for-in loop
//   - break out of a loop

// ─────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────

export fn cstyle_sum(): i32 {
    let total = 0;
    for (let i = 0; i < 5; i = i + 1) {
        total = total + i;
    }
    return total;
}

export fn cstyle_empty_range(): i32 {
    let total = 0;
    for (let i = 10; i < 10; i = i + 1) {
        total = total + 1;
    }
    return total;
}

export fn cstyle_multivar_pairs(): i32 {
    let pairs = 0;
    for (let i = 0, j = 10; i < j; i = i + 1, j = j - 1) {
        pairs = pairs + 1;
    }
    return pairs;
}

export fn count_odd_cstyle(): i32 {
    let odds = 0;
    for (let k = 0; k < 6; k = k + 1) {
        if (k % 2 == 0) {
            continue;
        }
        odds = odds + 1;
    }
    return odds;
}

export fn run_at_least_once(times: i32): i32 {
    let count = 0;
    do {
        count = count + 1;
    } while (count < times);
    return count;
}

export fn do_while_with_continue(): i32 {
    let n = 0;
    do {
        n = n + 1;
        if (n % 2 == 0) {
            continue;
        }
    } while (n < 5);
    return n;
}

export fn first_even_index(values: [int]): i32 {
    let found = -1;
    let i = 0;
    while (i < values.len()) {
        if (values[i] % 2 == 0) {
            found = i + 0;
            break;
        }
        i = i + 1;
    }
    return found;
}

export fn join_lengths(values: [int]): i32 {
    let total = 0;
    for (v in values) {
        total = total + v;
    }
    return total;
}

// ─────────────────────────────────────────────────────────────
// Test Cases
// ─────────────────────────────────────────────────────────────

export test fn test_cstyle_for_loop() {
    assert_eq(cstyle_sum(), 10);
    assert_eq(cstyle_empty_range(), 0);
    let steps = 0;
    for (let i = 1; i <= 4; i = i + 1) {
        steps = steps + 1;
    }
    assert_eq(steps, 4);
}

export test fn test_multivar_cstyle_for() {
    assert_eq(cstyle_multivar_pairs(), 5);
    let i_final = 0;
    let j_final = 0;
    for (let a = 0, b = 10; a < b; a = a + 1, b = b - 1) {
        i_final = a + 0;
        j_final = b + 0;
    }
    assert_eq(i_final, 4);
    assert_eq(j_final, 6);
}

export test fn test_continue_keeps_post_expression() {
    assert_eq(count_odd_cstyle(), 3);
    let evens = 0;
    for (let k = 0; k < 6; k = k + 1) {
        if (k % 2 != 0) {
            continue;
        }
        evens = evens + 1;
    }
    assert_eq(evens, 3);
}

export test fn test_do_while_runs_at_least_once() {
    assert_eq(run_at_least_once(3), 3);
    assert_eq(run_at_least_once(1), 1);
    let zero_runs = 0;
    do {
        zero_runs = zero_runs + 1;
    } while (zero_runs < 0);
    assert_eq(zero_runs, 1);
}

export test fn test_do_while_with_continue() {
    assert_eq(do_while_with_continue(), 5);
}

export test fn test_break_exits_early() {
    assert_eq(first_even_index([1, 3, 4, 6]), 2);
    assert_eq(first_even_index([1, 3, 5]), -1);
    assert_eq(first_even_index([]), -1);
}

export test fn test_for_in_accumulator() {
    assert_eq(join_lengths([1, 2, 3, 4, 5]), 15);
    assert_eq(join_lengths([]), 0);
    let count = 0;
    for (item in ["apple", "banana", "cherry"]) {
        count = count + 1;
    }
    assert_eq(count, 3);
}

// ─────────────────────────────────────────────────────────────
// Programmatic test suite runner for main.adesh integration
// ─────────────────────────────────────────────────────────────

export fn run_tests() {
    test_cstyle_for_loop();
    test_multivar_cstyle_for();
    test_continue_keeps_post_expression();
    test_do_while_runs_at_least_once();
    test_do_while_with_continue();
    test_break_exits_early();
    test_for_in_accumulator();
    return 7;
}

fn main() {
    print("Running 02_control_flow tests...");
    let count = run_tests();
    print(`Passed ${count} tests in 02_control_flow.test.adesh`);
}
