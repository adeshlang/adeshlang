// Test comparison operators

let a = 2;
let b = 10;

print("a =", a, "b =", b);
print("a < b:", a < b);
print("a <= b:", a <= b);
print("a > b:", a > b);
print("a >= b:", a >= b);
print("a == b:", a == b);

print("\nDirect literals:");
print("2 < 10:", 2 < 10);
print("2 <= 10:", 2 <= 10);

print("\nWhile loop test:");
let i = 2;
let n = 10;
let count = 0;
while (i <= n) {
    print("Loop iteration:", i);
    count = count + 1;
    i = i + 1;
    if (count > 20) {
        print("Breaking to prevent infinite loop");
        break;
    }
}
print("Loop executed", count, "times");
