// Demonstrates running a single test from a file

fn add(a, b) {
    return a + b;
}

test fn test_add_basic() {
    assert_eq(add(2, 3), 5);
}

test fn test_add_zero() {
    assert_eq(add(0, 9), 9);
}

test fn test_add_negative() {
    assert_eq(add(-2, 5), 3);
}

fn main() {
    print("This should not run in test mode");
}
