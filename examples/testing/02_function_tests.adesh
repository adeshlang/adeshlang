// Function Testing Examples
// Demonstrates testing functions and their behavior

// Helper functions to test
fn add(a, b) {
    return a + b;
}

fn multiply(a, b) {
    return a * b;
}

fn is_even(n) {
    return n % 2 == 0;
}

fn factorial(n) {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

// Test addition function
test fn test_add() {
    assert_eq(add(2, 3), 5);
    assert_eq(add(0, 0), 0);
    assert_eq(add(-5, 5), 0);
}

// Test multiplication function
test fn test_multiply() {
    assert_eq(multiply(3, 4), 12);
    assert_eq(multiply(0, 100), 0);
    assert_eq(multiply(-2, 5), -10);
}

// Test is_even function
test fn test_is_even() {
    assert(is_even(2));
    assert(is_even(0));
    assert(is_even(100));
    assert(!is_even(1));
    assert(!is_even(99));
}

// Test factorial function
test fn test_factorial() {
    assert_eq(factorial(0), 1);
    assert_eq(factorial(1), 1);
    assert_eq(factorial(5), 120);
    assert_eq(factorial(3), 6);
}

// Test edge cases
test fn test_edge_cases() {
    assert_eq(add(0, 0), 0);
    assert_eq(multiply(1, 1), 1);
}

fn main() {
    print("Function Testing Examples");
    print("Run with: adesh run --test 02_function_tests.adesh");
}
