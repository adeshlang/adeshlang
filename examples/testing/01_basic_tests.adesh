// Basic Test Examples
// Demonstrates fundamental testing features in Adesh
// @allow(warnings)
// Simple test with basic assertion
test fn test_true() {
    assert(true);
}

// Test with comparison
test fn test_comparison() {
    assert(5 > 3);
    assert(10 >= 10);
    assert(2 < 5);
}

// Test arithmetic operations
test fn test_arithmetic() {
    assert_eq(2 + 2, 4);
    assert_eq(10 - 5, 5);
    assert_eq(3 * 4, 12);
    assert_eq(15 / 3, 5);
}

// Test with custom message
test fn test_with_message() {
    let value = 100;
    assert(value > 0, "Value must be positive");
}

// Test string equality
test fn test_strings() {
    let name = "Adesh";
    assert_eq(name, "Adesh");
    assert_ne(name, "Python");
}

// Test boolean operations
test fn test_booleans() {
    assert(true or false);
    assert(true and true);
    assert_eq(false or false, false);
}

// Test with variables
test fn test_variables() {
    let x = 42;
    let y = 42;
    assert_eq(x, y);
    
    let a = 10;
    let b = 20;
    assert_ne(a, b);
}

// Main function (not a test)
fn main() {
    print("Basic Test Examples");
    print("Run with: adesh run --test 01_basic_tests.adesh");
}
