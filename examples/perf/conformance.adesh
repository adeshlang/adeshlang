// Cross-Backend Conformance Suite for AdeshLang
// Validates identical deterministic evaluation across Interpreter, VM, and JIT.

fn assert_eq(tag, actual, expected) {
    if (actual != expected) {
        print("FAIL [", tag, "]: expected", expected, "got", actual);
    } else {
        print("PASS [", tag, "]:", actual);
    }
}

// 1. Recursive Fibonacci
fn fib(n) {
    if (n <= 1) { return n; }
    return fib(n - 1) + fib(n - 2);
}

// 2. Arithmetic
fn math_ops(a, b) {
    let add = a + b;
    let sub = a - b;
    let mul = a * b;
    return add + sub + mul;
}

// 3. Loop Accumulator
fn loop_acc(limit) {
    let sum = 0;
    for (i in 0..1000) {
        sum = sum + ((i * 7 + 13) % 97);
    }
    return sum;
}

// Run tests
assert_eq("fib(12)", fib(12), 144);
assert_eq("math_ops(100, 7)", math_ops(100, 7), 900);
assert_eq("loop_acc(1000)", loop_acc(1000), 47861);
