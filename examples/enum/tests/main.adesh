// Enum Test Runner & Analytics Suite
// Imports test cases from all enum test modules and executes them step-by-step
// with rich analytics reporting.

import "./01_unit_variants.test.adesh" as unit_tests;
import "./02_payload_variants.test.adesh" as payload_tests;
import "./03_match_option.test.adesh" as match_tests;

// ─────────────────────────────────────────────────────────────
// Native Test Harness Declarations (for `adesh run --test`)
// ─────────────────────────────────────────────────────────────

test fn test_suite_unit_variants() {
    unit_tests.run_tests();
}

test fn test_suite_payload_variants() {
    payload_tests.run_tests();
}

test fn test_suite_match_option() {
    match_tests.run_tests();
}

// ─────────────────────────────────────────────────────────────
// Standalone Test Runner & Analytics Engine
// ─────────────────────────────────────────────────────────────

struct TestSuiteResult {
    suite_name: string;
    total: i32;
    passed: i32;
    failed: i32;
};

fn run_single_test(test_name: string, test_fn): bool {
    try {
        test_fn();
        print(`  ✓ PASS: ${test_name}`);
        return true;
    } catch (err) {
        print(`  ✗ FAIL: ${test_name} - Error: ${err}`);
        return false;
    }
}

fn print_analytics_dashboard(
    unit_res: TestSuiteResult,
    payload_res: TestSuiteResult,
    match_res: TestSuiteResult
) {
    let total_all = unit_res.total + payload_res.total + match_res.total;
    let passed_all = unit_res.passed + payload_res.passed + match_res.passed;
    let failed_all = unit_res.failed + payload_res.failed + match_res.failed;
    let pass_rate = (passed_all * 100) / total_all;

    print("");
    print("╔══════════════════════════════════════════════════════════════════════╗");
    print("║                     TEST ANALYTICS DASHBOARD                         ║");
    print("╠══════════════════════════════════════════════════════════════════════╣");
    print("║  Suite Name              │ Total │ Passed │ Failed │ Pass Rate       ║");
    print("╟──────────────────────────┼───────┼────────┼────────┼─────────────────╢");
    print(`║  01_unit_variants        │   ${unit_res.total}   │   ${unit_res.passed}    │   ${unit_res.failed}    │ ${pass_rate}%            ║`);
    print(`║  02_payload_variants     │   ${payload_res.total}   │   ${payload_res.passed}    │   ${payload_res.failed}    │ ${pass_rate}%            ║`);
    print(`║  03_match_option         │   ${match_res.total}   │   ${match_res.passed}    │   ${match_res.failed}    │ ${pass_rate}%            ║`);
    print("╠══════════════════════════════════════════════════════════════════════╣");
    print(`║  TOTAL OVERALL           │  ${total_all}   │  ${passed_all}   │   ${failed_all}    │ ${pass_rate}%            ║`);
    print("╚══════════════════════════════════════════════════════════════════════╝");
    print("");
    if (failed_all == 0) {
        print(`  🎉 ALL ENUM TESTS PASSED SUCCESSFULLY! (${passed_all}/${total_all} tests)`);
    } else {
        print(`  ⚠️ WARNING: ${failed_all} test(s) failed.`);
    }
    print("");
}

fn main() {
    print("╔══════════════════════════════════════════════════════════════════════╗");
    print("║              AdeshLang Enum - Test Execution Runner                  ║");
    print("╚══════════════════════════════════════════════════════════════════════╝");
    print("");

    // Suite 1: Unit Variant Tests
    print("▶ [1/3] Running Suite: 01_unit_variants.test.adesh");
    let u1 = 0;
    u1 = u1 + (run_single_test("unit_tests.test_direction_tags", unit_tests.test_direction_tags) ? 1 : 0);
    u1 = u1 + (run_single_test("unit_tests.test_enum_metadata", unit_tests.test_enum_metadata) ? 1 : 0);
    u1 = u1 + (run_single_test("unit_tests.test_tag_based_dispatch", unit_tests.test_tag_based_dispatch) ? 1 : 0);
    u1 = u1 + (run_single_test("unit_tests.test_new_vs_plain_construction", unit_tests.test_new_vs_plain_construction) ? 1 : 0);
    u1 = u1 + (run_single_test("unit_tests.test_variant_inequality", unit_tests.test_variant_inequality) ? 1 : 0);
    let unit_res = TestSuiteResult {
        suite_name: "01_unit_variants",
        total: 5,
        passed: u1,
        failed: 5 - u1,
    };
    print(`  Suite Result: ${u1}/5 tests passed\n`);

    // Suite 2: Payload Variant Tests
    print("▶ [2/3] Running Suite: 02_payload_variants.test.adesh");
    let p1 = 0;
    p1 = p1 + (run_single_test("payload_tests.test_single_payload", payload_tests.test_single_payload) ? 1 : 0);
    p1 = p1 + (run_single_test("payload_tests.test_multi_payload_array", payload_tests.test_multi_payload_array) ? 1 : 0);
    p1 = p1 + (run_single_test("payload_tests.test_optional_payload_is_null", payload_tests.test_optional_payload_is_null) ? 1 : 0);
    p1 = p1 + (run_single_test("payload_tests.test_new_keyword_payload", payload_tests.test_new_keyword_payload) ? 1 : 0);
    p1 = p1 + (run_single_test("payload_tests.test_query_result_payloads", payload_tests.test_query_result_payloads) ? 1 : 0);
    p1 = p1 + (run_single_test("payload_tests.test_multi_payload_sum", payload_tests.test_multi_payload_sum) ? 1 : 0);
    let payload_res = TestSuiteResult {
        suite_name: "02_payload_variants",
        total: 6,
        passed: p1,
        failed: 6 - p1,
    };
    print(`  Suite Result: ${p1}/6 tests passed\n`);

    // Suite 3: Match & Option Tests
    print("▶ [3/3] Running Suite: 03_match_option.test.adesh");
    let m1 = 0;
    m1 = m1 + (run_single_test("match_tests.test_match_payload_binding", match_tests.test_match_payload_binding) ? 1 : 0);
    m1 = m1 + (run_single_test("match_tests.test_match_unit_qualified_patterns", match_tests.test_match_unit_qualified_patterns) ? 1 : 0);
    m1 = m1 + (run_single_test("match_tests.test_terminal_narrowing", match_tests.test_terminal_narrowing) ? 1 : 0);
    m1 = m1 + (run_single_test("match_tests.test_option_match_expression", match_tests.test_option_match_expression) ? 1 : 0);
    m1 = m1 + (run_single_test("match_tests.test_option_tag_value", match_tests.test_option_tag_value) ? 1 : 0);
    m1 = m1 + (run_single_test("match_tests.test_query_result_match", match_tests.test_query_result_match) ? 1 : 0);
    let match_res = TestSuiteResult {
        suite_name: "03_match_option",
        total: 6,
        passed: m1,
        failed: 6 - m1,
    };
    print(`  Suite Result: ${m1}/6 tests passed\n`);

    // Final Analytics Dashboard
    print_analytics_dashboard(unit_res, payload_res, match_res);
}
