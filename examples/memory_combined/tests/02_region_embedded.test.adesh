// Region + Embedded Tests (Combined)
// Covers examples/memory_combined/region_with_ownership.adesh,
// embedded_mode_example.adesh and examples/region/*.adesh:
//   - arena region: values live inside the region, bulk-freed at exit
//   - move/copy of owned values within the region
//   - nested regions free inner allocations first (LIFO)
//   - depth tracking: references deeper than the current scope escape
//   - embedded rules: no heap allocation, fixed stack budget, deterministic
//     sensor processing
// Pure simulation plus real `region` blocks (supported by the interpreter).

// ─────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────

struct Message {
    id: i32;
    text: i32;
};

export fn make_message(id: i32, text: i32) {
    return Message { id: id, text: text };
}

// Event-driven region simulator.
// Events: "enter" (open a nested region), "alloc" (one object in the
// innermost region), "exit" (bulk-free everything in the innermost region).
// Returns [live_at_end, peak_live].
export fn region_sim(events: [str]): [i32] {
    let stack: [i32] = [0];
    let live = 0;
    let peak = 0;
    for (e in events) {
        if (e == "enter") {
            stack.push(0);
        } else if (e == "exit") {
            let idx = stack.len() - 1;
            live = live - stack[idx];
            stack[idx] = 0;
            if (stack.len() > 1) {
                stack = stack.slice(0, stack.len() - 1);
            }
        } else if (e == "alloc") {
            let idx2 = stack.len() - 1;
            stack[idx2] = stack[idx2] + 1;
            live = live + 1;
            if (live > peak) {
                peak = live;
            }
        }
    }
    return [live, peak];
}

// Escape analysis: a reference is valid only while its creation depth
// is not deeper than the current scope depth.
// Returns how many of the given references escape their scope.
export fn escape_check(created_depths: [int], current_depth: i32): i32 {
    let escaped = 0;
    for (d in created_depths) {
        if (d > current_depth) {
            escaped = escaped + 1;
        }
    }
    return escaped;
}

// Real nested region demo: records a marker per phase.
// Returns [outer_marker, inner_marker, after_inner, after_outer].
export fn nested_region_demo(): [i32] {
    let log: [i32] = [];
    region OuterScope {
        log.push(1);
        region InnerScope {
            log.push(2);
        }
        log.push(3);
    }
    log.push(4);
    return log;
}

struct Sensor {
    id: i32;
    value: i32;
};

export fn process_sensor(s: Sensor): i32 {
    return s.value * 2;
}

// Embedded allocation rules: heap requests are rejected outright (-2),
// stack requests that overflow the fixed budget return -1.
export fn embedded_alloc(heap_allocs: i32, used: i32, budget: i32, request: i32): i32 {
    if (heap_allocs > 0) {
        return -2;
    }
    if (used + request > budget) {
        return -1;
    }
    return used + request;
}

// ─────────────────────────────────────────────────────────────
// Test Cases
// ─────────────────────────────────────────────────────────────

export test fn test_messages_in_arena() {
    let msg1 = make_message(1, 100);
    let msg2 = make_message(2, 200);
    assert_eq(msg1.id, 1);
    assert_eq(msg2.id, 2);
    assert_eq(msg1.text, 100);
    assert_eq(msg1.text + msg2.text, 300);
}

export test fn test_move_within_region_preserves_values() {
    let msg1 = make_message(1, 100);
    // ownership move inside the region: the new binding carries the data
    let msg3 = make_message(msg1.id, msg1.text);
    assert_eq(msg3.id, 1);
    assert_eq(msg3.text, 100);
    assert_eq(msg3.id + msg3.text, 101);
    assert_eq(msg1.id, 1);
}

export test fn test_region_bulk_free_simulation() {
    let basic = region_sim(["enter", "alloc", "alloc", "alloc", "exit"]);
    assert_eq(basic[0], 0);
    assert_eq(basic[1], 3);

    let nested = region_sim(["enter", "alloc", "enter", "alloc", "alloc", "exit", "alloc"]);
    assert_eq(nested[0], 2);
    assert_eq(nested[1], 3);

    let closed = region_sim(["enter", "alloc", "enter", "alloc", "exit", "exit"]);
    assert_eq(closed[0], 0);
    assert_eq(closed[1], 2);

    let empty = region_sim([]);
    assert_eq(empty[0], 0);
    assert_eq(empty[1], 0);
}

export test fn test_nested_regions_run_in_order() {
    let log = nested_region_demo();
    assert_eq(log.len(), 4);
    assert_eq(log[0], 1);
    assert_eq(log[1], 2);
    assert_eq(log[2], 3);
    assert_eq(log[3], 4);
}

export test fn test_escape_detection() {
    // references created at or above the current depth are fine
    assert_eq(escape_check([1, 2], 2), 0);
    assert_eq(escape_check([], 3), 0);
    // a reference created deeper than the current scope escapes
    assert_eq(escape_check([1, 3], 2), 1);
    assert_eq(escape_check([1, 2, 3], 1), 2);
    // after the region exited everything is an escape
    assert_eq(escape_check([1, 2], 0), 2);
}

export test fn test_embedded_deterministic_ops() {
    let sensor = Sensor { id: 1, value: 42 };
    assert_eq(process_sensor(sensor), 84);
    let zero = Sensor { id: 2, value: 0 };
    assert_eq(process_sensor(zero), 0);

    // heap allocation is rejected in embedded mode
    assert_eq(embedded_alloc(1, 0, 256, 64), -2);
    // stack overflow is detected against the fixed budget
    assert_eq(embedded_alloc(0, 200, 256, 64), -1);
    // a fitting stack allocation succeeds
    assert_eq(embedded_alloc(0, 200, 256, 56), 256);
    assert_eq(embedded_alloc(0, 0, 256, 256), 256);
}

// ─────────────────────────────────────────────────────────────
// Programmatic test suite runner for main.adesh integration
// ─────────────────────────────────────────────────────────────

export fn run_tests() {
    test_messages_in_arena();
    test_move_within_region_preserves_values();
    test_region_bulk_free_simulation();
    test_nested_regions_run_in_order();
    test_escape_detection();
    test_embedded_deterministic_ops();
    return 6;
}

fn main() {
    print("Running 02_region_embedded tests...");
    let count = run_tests();
    print(`Passed ${count} tests in 02_region_embedded.test.adesh`);
}
