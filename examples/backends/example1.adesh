// example1.ind - Basic example demonstrating multi-backend compilation
// This file can be executed using:
// - HIR Interpreter
// - Cranelift JIT (interpreter-style)
// - LLVM AOT (stub - not yet implemented)

// Variable declarations
let a = 10;
let b = a + 5;

// Print result
print(b);

// Function definition
fn add(x, y) {
    return x + y;
}

// Function call
let result = add(3, 4);
print(result);

// Conditional
if (result > 5) {
    print("Result is greater than 5");
}

// Loop
let i = 0;
while (i < 5) {
    print(i);
    i = i + 1;
}

print("Example complete!");
