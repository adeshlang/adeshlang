// Memory Allocator Test Runner & Analytics Suite
// Imports test cases from all memory_allocator test modules and executes
// them step-by-step with rich analytics reporting.

import "./01_growth_strategies.test.adesh" as growth_tests;
import "./02_static_budget.test.adesh" as budget_tests;
import "./03_hybrid_stress.test.adesh" as hybrid_tests;

// ─────────────────────────────────────────────────────────────
// Native Test Harness Declarations (for `adesh run --test`)
// ─────────────────────────────────────────────────────────────

test fn test_suite_growth_strategies() {
    growth_tests.run_tests();
}

test fn test_suite_static_budget() {
    budget_tests.run_tests();
}

test fn test_suite_hybrid_stress() {
    hybrid_tests.run_tests();
}

// ─────────────────────────────────────────────────────────────
// Standalone Test Runner & Analytics Engine
// ─────────────────────────────────────────────────────────────

struct TestSuiteResult {
    suite_name: string;
    total: i32;
    passed: i32;
    failed: i32;
};

fn run_single_test(test_name: string, test_fn): bool {
    try {
        test_fn();
        print(`  ✓ PASS: ${test_name}`);
        return true;
    } catch (err) {
        print(`  ✗ FAIL: ${test_name} - Error: ${err}`);
        return false;
    }
}

fn print_analytics_dashboard(
    growth_res: TestSuiteResult,
    budget_res: TestSuiteResult,
    hybrid_res: TestSuiteResult
) {
    let total_all = growth_res.total + budget_res.total + hybrid_res.total;
    let passed_all = growth_res.passed + budget_res.passed + hybrid_res.passed;
    let failed_all = growth_res.failed + budget_res.failed + hybrid_res.failed;
    let pass_rate = (passed_all * 100) / total_all;

    print("");
    print("╔══════════════════════════════════════════════════════════════════════╗");
    print("║                     TEST ANALYTICS DASHBOARD                         ║");
    print("╠══════════════════════════════════════════════════════════════════════╣");
    print("║  Suite Name              │ Total │ Passed │ Failed │ Pass Rate       ║");
    print("╟──────────────────────────┼───────┼────────┼────────┼─────────────────╢");
    print(`║  01_growth_strategies    │   ${growth_res.total}   │   ${growth_res.passed}    │   ${growth_res.failed}    │ ${pass_rate}%            ║`);
    print(`║  02_static_budget        │   ${budget_res.total}   │   ${budget_res.passed}    │   ${budget_res.failed}    │ ${pass_rate}%            ║`);
    print(`║  03_hybrid_stress        │   ${hybrid_res.total}   │   ${hybrid_res.passed}    │   ${hybrid_res.failed}    │ ${pass_rate}%            ║`);
    print("╠══════════════════════════════════════════════════════════════════════╣");
    print(`║  TOTAL OVERALL           │  ${total_all}   │  ${passed_all}   │   ${failed_all}    │ ${pass_rate}%            ║`);
    print("╚══════════════════════════════════════════════════════════════════════╝");
    print("");
    if (failed_all == 0) {
        print(`  🎉 ALL ALLOCATOR TESTS PASSED SUCCESSFULLY! (${passed_all}/${total_all} tests)`);
    } else {
        print(`  ⚠️ WARNING: ${failed_all} test(s) failed.`);
    }
    print("");
}

fn main() {
    print("╔══════════════════════════════════════════════════════════════════════╗");
    print("║         AdeshLang Memory Allocator - Test Execution Runner           ║");
    print("╚══════════════════════════════════════════════════════════════════════╝");
    print("");

    // Suite 1: Growth Strategy Tests
    print("▶ [1/3] Running Suite: 01_growth_strategies.test.adesh");
    let g1 = 0;
    g1 = g1 + (run_single_test("growth_tests.test_doubling_growth", growth_tests.test_doubling_growth) ? 1 : 0);
    g1 = g1 + (run_single_test("growth_tests.test_linear_growth", growth_tests.test_linear_growth) ? 1 : 0);
    g1 = g1 + (run_single_test("growth_tests.test_no_resize_when_capacity_sufficient", growth_tests.test_no_resize_when_capacity_sufficient) ? 1 : 0);
    g1 = g1 + (run_single_test("growth_tests.test_capacity_curve_shape", growth_tests.test_capacity_curve_shape) ? 1 : 0);
    g1 = g1 + (run_single_test("growth_tests.test_growth_spend_doubling_vs_linear", growth_tests.test_growth_spend_doubling_vs_linear) ? 1 : 0);
    g1 = g1 + (run_single_test("growth_tests.test_dynamic_allocation_totals", growth_tests.test_dynamic_allocation_totals) ? 1 : 0);
    let growth_res = TestSuiteResult {
        suite_name: "01_growth_strategies",
        total: 6,
        passed: g1,
        failed: 6 - g1,
    };
    print(`  Suite Result: ${g1}/6 tests passed\n`);

    // Suite 2: Static Budget / OOM Tests
    print("▶ [2/3] Running Suite: 02_static_budget.test.adesh");
    let b1 = 0;
    b1 = b1 + (run_single_test("budget_tests.test_small_allocations_fit", budget_tests.test_small_allocations_fit) ? 1 : 0);
    b1 = b1 + (run_single_test("budget_tests.test_over_budget_rejected", budget_tests.test_over_budget_rejected) ? 1 : 0);
    b1 = b1 + (run_single_test("budget_tests.test_allocation_sequence", budget_tests.test_allocation_sequence) ? 1 : 0);
    b1 = b1 + (run_single_test("budget_tests.test_oom_throws_catchable", budget_tests.test_oom_throws_catchable) ? 1 : 0);
    b1 = b1 + (run_single_test("budget_tests.test_budget_exhaustion_accounting", budget_tests.test_budget_exhaustion_accounting) ? 1 : 0);
    let budget_res = TestSuiteResult {
        suite_name: "02_static_budget",
        total: 5,
        passed: b1,
        failed: 5 - b1,
    };
    print(`  Suite Result: ${b1}/5 tests passed\n`);

    // Suite 3: Hybrid Strategy & Stress Tests
    print("▶ [3/3] Running Suite: 03_hybrid_stress.test.adesh");
    let h1 = 0;
    h1 = h1 + (run_single_test("hybrid_tests.test_process_batch_pipeline", hybrid_tests.test_process_batch_pipeline) ? 1 : 0);
    h1 = h1 + (run_single_test("hybrid_tests.test_hybrid_batch_totals", hybrid_tests.test_hybrid_batch_totals) ? 1 : 0);
    h1 = h1 + (run_single_test("hybrid_tests.test_arena_heap_split", hybrid_tests.test_arena_heap_split) ? 1 : 0);
    h1 = h1 + (run_single_test("hybrid_tests.test_stress_allocation_totals", hybrid_tests.test_stress_allocation_totals) ? 1 : 0);
    h1 = h1 + (run_single_test("hybrid_tests.test_mixed_allocation_sizes", hybrid_tests.test_mixed_allocation_sizes) ? 1 : 0);
    let hybrid_res = TestSuiteResult {
        suite_name: "03_hybrid_stress",
        total: 5,
        passed: h1,
        failed: 5 - h1,
    };
    print(`  Suite Result: ${h1}/5 tests passed\n`);

    // Final Analytics Dashboard
    print_analytics_dashboard(growth_res, budget_res, hybrid_res);
}
