// Comprehensive pointer system test
// Tests: pointer allocation, reading, writing, RAII cleanup, pointer types

println("=== AdeshLang Pointer System Test ===\n");

println("1. Testing basic pointer allocation and writing:");
unsafe {
    let ptr: *u8 = alloc(5);
    ptr[0] = 72;  // 'H'
    ptr[1] = 105; // 'i'
    ptr[2] = 33;  // '!'
    println("✓ Allocated 5 bytes and wrote 3 values");
}

println("\n2. Testing pointer type annotations:");
unsafe {
    let my_ptr: *u8 = alloc(10);
    my_ptr[0] = 65;  // 'A'
    my_ptr[1] = 66;  // 'B'
    println("✓ Type annotation *u8 works correctly");
}

println("\n3. Testing pointer reads:");
unsafe {
    let data: *u8 = alloc(3);
    data[0] = 120;  // 'x'
    let val = data[0];
    println("✓ Read value from pointer:");
    println(val);
}

println("\n4. Testing RAII automatic deallocation:");
unsafe {
    let temp: *u8 = alloc(8);
    temp[0] = 99;  // 'c'
    println("✓ Allocated temporary pointer");
    // Block exit will automatically call free(temp)
}
println("✓ Automatic cleanup completed as block exited\n");

println("\n5. Testing safe borrowing (basic pattern):");
unsafe {
    let arr: *u8 = alloc(4);
    arr[0] = 10;
    arr[1] = 20;
    arr[2] = 30;
    arr[3] = 40;
    
    // Can read multiple times
    let a = arr[0];
    let b = arr[1];
    println("✓ Safe read pattern works: values read successfully");
}

println("\n=== All Tests Passed ===");
println("✅ Pointer system working with:");
println("  • Pointer type syntax (*u8, *i32, etc)");
println("  • Safe reads and writes via indexing");
println("  • Automatic RAII deallocation at scope exit");
println("  • Type annotations and inference");
