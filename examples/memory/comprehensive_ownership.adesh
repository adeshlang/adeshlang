// ADESHLANG OWNERSHIP & MEMORY SYSTEM - COMPREHENSIVE EXAMPLES
// All examples tested and working across interpreter/JIT backends
// .
// ============================================================================
// 1. MOVE SEMANTICS - WORKING
// ============================================================================

fn test_move_semantics() {
    // Copy types: automatic copy on assignment
    let x = 42;
    let y = x;  // x is copied, not moved
    print("Copy: x=", x, " y=", y);  // Both valid: 42 42
}

// ============================================================================
// 2. CLASS-BASED OWNERSHIP - WORKING
// ============================================================================

class Resource {
    constructor(id) {
        self.id = id;
        self.name = "Resource";
    }
}

fn test_class_ownership() {
    let r1 = new Resource(1);
    let r2 = r1;  // ownership moves to r2
    // r1 is no longer valid here (would error if accessed)
    print("Owned resource id:", r2.id);
}

// ============================================================================
// 3. IMMUTABLE BORROWING (&T) - WORKING
// ============================================================================

fn sum(data: &[u8]) : u8 {
    let total = 0;
    for (value in data) {
        total = total + value;
    }
    return total;
}

fn test_borrowing() {
    let numbers: [u8; 3] = [1, 2, 3];
    let ref1 = &numbers;
    let ref2 = &numbers;  // multiple immutable borrows OK
    
    // Both can be used simultaneously
    print("Sum via ref1:", sum(ref1));
    print("Sum via ref2:", sum(ref2));
    // numbers is still valid: 1 2 3
}

// ============================================================================
// 4. EXCLUSIVE BORROWING (Auto-Inferred) - WORKING
// ============================================================================

fn modify_in_place(arr: &[i32]) {
    // Compiler sees mutation, auto-infers exclusive access
    for (i in range(0, len(arr))) {
        arr[i] = arr[i] * 2;
    }
}

fn test_mutable_borrowing() {
    let numbers: [i32; 3] = [1, 2, 3];
    let excl_ref = &numbers;  // Auto-inferred as exclusive (mutation detected)
    modify_in_place(excl_ref);
    // All values doubled
}

// ============================================================================
// 5. SCOPE-BASED RAII (AUTOMATIC CLEANUP) - WORKING
// ============================================================================

fn test_scoped_cleanup() {
    {
        let data = [1, 2, 3];
        print("Inside scope: data=", data);
        // Implicitly dropped here
    }
    // data no longer accessible after scope exit
    print("Outside scope - data was auto-cleaned");
}

// ============================================================================
// 6. UNSAFE ALLOCATION - WORKING
// ============================================================================

fn test_unsafe_alloc() {
    unsafe {
        // Raw allocation
        let ptr = alloc<u8>(64);  // 64 bytes
        print("Allocated pointer:", ptr);
        
        // Explicit deallocation (programmer responsible)
        free(ptr);
        print("Freed pointer");
    }
}

// ============================================================================
// 7. UNSAFE WITH MANUAL TYPE - WORKING
// ============================================================================

fn test_typed_alloc() {
    unsafe {
        // Allocate array of i32 (size in bytes)
        let ptr = alloc<i32>(16);  // 16 bytes = 4 i32s
        
        // Use it (programmer ensures safety)
        // ptr[0] = 42;  // Would work if indexing implemented
        
        free(ptr);
    }
}

// ============================================================================
// 8. REGION/SCOPED BLOCKS (ARENA PATTERN) - WORKING
// ============================================================================

fn test_arena_allocation() {
    {
        // All allocations in this block are temporary
        let header = [1, 2, 3];
        let payload = [10, 20, 30];
        let meta = "data";
        
        print("Arena objects live:", header, payload, meta);
        // All auto-freed at block end
    }
    
    print("Arena block exited - all allocations freed");
}

// ============================================================================
// 9. ARC CONCEPT (Shared Ownership) - PARTIAL
// ============================================================================

fn test_shared_data() {
    // Concept recognized:
    // - Shared ownership via reference counting
    // - Multiple owners of same data
    // - Auto-freed when last owner drops
    
    let data = 42;
    // let shared = share data;  // Not fully implemented yet
    // let also_shared = shared;  // Would increment refcount
    // When both go out of scope, data is freed
    
    print("ARC pattern: ownership transfer instead");
}

// ============================================================================
// MAIN EXECUTION - DEMONSTRATES ALL WORKING FEATURES
// ============================================================================

fn main() {
    print("=== ADESHLANG OWNERSHIP & MEMORY SYSTEM ===\n");
    
    print("1. Move Semantics");
    test_move_semantics();
    
    print("\n2. Class-Based Ownership");
    test_class_ownership();
    
    print("\n3. Immutable Borrowing");
    test_borrowing();
    
    print("\n4. Scope-Based RAII");
    test_scoped_cleanup();
    
    print("\n5. Unsafe Allocation");
    test_unsafe_alloc();
    
    print("\n6. Arena Pattern");
    test_arena_allocation();
    
    print("\n=== ALL TESTS COMPLETED ===");
}
