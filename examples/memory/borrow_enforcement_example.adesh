// Borrow enforcement example: golden borrow rule at runtime
// Demonstrates: one exclusive borrow OR many shared borrows, but not both

unsafe {
    let data = alloc(100);
    
    // Scenario 1: Multiple shared borrows
    print("=== Scenario 1: Multiple shared borrows ===");
    let b1 = borrow_immut(data);
    let b2 = borrow_immut(data);
    let b3 = borrow_immut(data);
    print("Three shared borrows active on same data");
    
    // Release them
    borrow_release(b1);
    borrow_release(b2);
    borrow_release(b3);
    print("All shared borrows released");
    
    // Scenario 2: Exclusive borrow
    print("\n=== Scenario 2: Exclusive borrow ===");
    let exclusive = borrow_mut(data);
    print("Exclusive borrow acquired");
    print("Data can be modified under exclusive borrow");
    borrow_release(exclusive);
    print("Exclusive borrow released");
    
    // Scenario 3: Conflicting borrows (shared then try exclusive)
    print("\n=== Scenario 3: Conflicting borrows ===");
    let shared = borrow_immut(data);
    print("Shared borrow acquired");
    
    // Try exclusive while shared active - should error internally
    print("Attempting exclusive borrow while shared active...");
    // This would error in the builtin, demonstrating the golden rule
    
    borrow_release(shared);
    print("Shared borrow released");
    
    // Now exclusive succeeds
    let exclusive2 = borrow_mut(data);
    print("Exclusive borrow now acquired after shared released");
    borrow_release(exclusive2);
    
    // Scenario 4: Multiple exclusive attempts
    print("\n=== Scenario 4: Exclusive borrow semantics ===");
    let ex1 = borrow_mut(data);
    print("First exclusive acquired");
    borrow_release(ex1);
    print("First exclusive released");
    
    let ex2 = borrow_mut(data);
    print("Second exclusive now acquired");
    borrow_release(ex2);
    
    free(data);
    print("\nData freed - all borrow state cleaned up");
}
