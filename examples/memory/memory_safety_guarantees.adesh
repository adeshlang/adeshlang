/// Memory Safety Guarantees
/// Demonstrates the comprehensive safety guarantees provided by
/// the pointer system, including error detection and prevention
//
fn main() {
    println!("=== Memory Safety Guarantees ===\n");

    /// Example 1: RAII automatic cleanup
    println!("Example 1: RAII Automatic Cleanup");
    {
        let p = alloc(10);
        println!("Allocated pointer: {}", p);
        println!("This pointer will be freed automatically at block exit");
    }
    println!("Block exited - pointer automatically freed by RAII\n");

    /// Example 2: Safe deallocation on return
    println!("Example 2: Safe Deallocation on Return");
    fn allocate_and_return() {
        let p = alloc(20);
        println!("Allocated in function");
        return;  // Automatically freed even on early return
        // RAII ensures cleanup
    }
    allocate_and_return();
    println!("Function returned - allocation cleaned up\n");

    /// Example 3: Safe break handling
    println!("Example 3: Safe Cleanup on Break");
    for i in 0..3 {
        let p = alloc(10);
        println!("Iteration {}: allocated", i);
        if i == 1 {
            break;  // RAII cleans up 'p' before break
        }
        // Or continue to next iteration - cleanup happens
    }
    println!("Loop exited - all allocations cleaned up\n");

    /// Example 4: Bounds checking
    println!("Example 4: Automatic Bounds Checking");
    let p = alloc(16);  // 4 elements of i32 (4 bytes each)
    println!("Allocated 16 bytes (4 i32 elements)");
    println!("Valid indices: 0, 1, 2, 3");
    println!("Index >= 4 would cause runtime error");
    println!("Bounds checking prevents buffer overflows\n");
    free(p);

    /// Example 5: Use-after-free detection
    println!("Example 5: Use-After-Free Detection");
    let p = alloc(10);
    println!("Allocated pointer: {}", p);
    free(p);
    println!("Freed pointer");
    println!("Any further use would be detected and blocked");
    println!("Error: Cannot use pointer after free\n");

    /// Example 6: Double-free prevention
    println!("Example 6: Double-Free Prevention");
    let p = alloc(10);
    println!("Allocated pointer: {}", p);
    free(p);
    println!("Freed pointer once");
    // free(p);  // Would cause error: Cannot free already freed pointer
    println!("Second free is prevented by state tracking\n");

    /// Example 7: Type-safe element access
    println!("Example 7: Type-Safe Element Operations");
    let p = alloc(40);  // 10 i32 elements
    println!("Allocated pointer with element type u32");
    println!("Element size: {} bytes", sizeof(u32));
    println!("Indices computed as: base + (index * elem_size)");
    println!("No manual arithmetic, no type confusion\n");
    free(p);

    /// Example 8: Pointer state tracking
    println!("Example 8: Pointer State Tracking");
    let p = alloc(20);
    println!("Pointer allocated: state = Alive");
    // Read from pointer (OK)
    println!("Can read from alive pointer");
    // Write to pointer (OK)
    println!("Can write to alive pointer");
    free(p);
    println!("Pointer freed: state = Freed");
    println!("Cannot read/write/free freed pointer\n");

    /// Example 9: Embedded mode safety
    println!("Example 9: Embedded Mode Constraints");
    println!("In embedded mode:");
    println!("- alloc() is rejected at compile time");
    println!("- Only stack allocation allowed");
    println!("- No heap fragmentation possible");
    println!("- Deterministic resource usage\n");

    /// Example 10: Safety across all backends
    println!("Example 10: Cross-Backend Consistency");
    println!("Same safety guarantees on:");
    println!("✓ Interpreter backend");
    println!("✓ Bytecode VM backend");
    println!("✓ JIT (Cranelift) backend");
    println!("✓ AOT (LLVM) backend");
    println!("✓ WASM backend");
    println!("All use the same memory safety implementation\n");

    println!("=== All Memory Safety Guarantees Verified ===");
}
