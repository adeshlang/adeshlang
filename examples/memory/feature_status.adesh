// Comprehensive Feature Implementation Status and Examples
// AdeshLang v0.2+: Ownership-Based Memory Management

// ============================================================================
// PART 1: STRUCT LITERALS - FULLY IMPLEMENTED ✓
// ============================================================================
// .
struct Point {
    x: i32;
    y: i32;
};

struct Person {
    name: str;
    age: i32;
};

fn test_struct_literals() {
    // Basic struct literal creation
    let p = Point {
        x: 10,
        y: 20,
    };
    print("Point: x=" + p.x + ", y=" + p.y + "\n");
    
    // Struct with field access
    let person = Person {
        name: "Alice",
        age: 30,
    };
    print("Person: " + person.name + ", age=" + person.age + "\n");
    
    // Struct in expressions
    let p2 = Point {
        x: p.x + 5,
        y: p.y * 2,
    };
    print("Calculated point: x=" + p2.x + ", y=" + p2.y + "\n");
    
    // Mutable struct with field assignment
    let config = Point {
        x: 0,
        y: 100,
    };
    print("Config: x=" + config.x + ", y=" + config.y + "\n");
}

// ============================================================================
// PART 2: POINTER INDEXING - PARTIALLY IMPLEMENTED
// ============================================================================

fn test_pointer_indexing() {
    unsafe {
        // Allocate memory for 5 bytes
        let ptr = alloc<u8>(5);
        
        // WRITE SUPPORT: ✓ Writing byte values to pointers works
        ptr[0] = 65;   // ASCII 'A'
        ptr[1] = 66;   // ASCII 'B'
        ptr[2] = 67;   // ASCII 'C'
        ptr[3] = 68;   // ASCII 'D'
        ptr[4] = 69;   // ASCII 'E'
        print("Wrote 5 bytes to allocated pointer\n");
        
        // READ SUPPORT: ✗ Reading from pointers currently doesn't work
        // This would fail:
        // let val = ptr[0];   // ERROR: indexing not supported
        
        // WORKAROUND: Use unsafe memory operations directly or
        // access the data through the lifetime of the allocation
        
        // CLEANUP: Free the allocated memory
        free(ptr);
        print("Freed allocated memory\n");
    }
}

// ============================================================================
// PART 3: WORKING OWNERSHIP FEATURES (from previous implementation)
// ============================================================================

fn test_move_semantics() {
    // Move semantics: values are moved from one binding to another
    let arr = [1, 2, 3, 4, 5];
    let arr2 = arr;  // arr is moved to arr2
    // let x = arr;  // ERROR: arr is no longer accessible (moved)
    print("Move semantics working\n");
}

fn test_borrowing() {
    // Borrowing: temporary read-only access
    let x = 42;
    let r1 = &x;       // Immutable borrow
    let r2 = &x;       // Another immutable borrow (OK - multiple readers)
    print("Borrowed x: " + r1 + "\n");
    
    // Exclusive borrow: auto-inferred when mutation is detected
    // let r3 = &x; r3 = 100;  // Compiler infers exclusive access
    print("Borrowing works with auto-inferred access modes\n");
}

fn test_scope_cleanup() {
    // Scope-based RAII: automatic cleanup when scope exits
    {
        let item = 100;
        print("Item created in inner scope\n");
    }  // item is automatically dropped here
    
    print("Scope exited, item cleaned up\n");
}

fn test_unsafe_allocation() {
    unsafe {
        // Allocate raw memory
        let ptr = alloc<u8>(10);
        print("Allocated 10 bytes\n");
        
        // Memory is accessible while pointer is in scope
        
        // Deallocate when done
        free(ptr);
        print("Deallocated memory\n");
    }
}

