// ============================================================================
// MAIN TEST SUITE
// ============================================================================

fn main() {
    print("=== AdeshLang Ownership & Features Test ===\n");
    
    print("\n1. Struct Literals:\n");
    test_struct_literals();
    
    print("\n2. Pointer Indexing:\n");
    test_pointer_indexing();
    
    print("\n3. Move Semantics:\n");
    test_move_semantics();
    
    print("\n4. Borrowing:\n");
    test_borrowing();
    
    print("\n5. Scope Cleanup:\n");
    test_scope_cleanup();
    
    print("\n6. Unsafe Allocation:\n");
    test_unsafe_allocation();
    
    print("\n=== All tests completed ===\n");
}
