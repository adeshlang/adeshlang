// Loop Algorithms Tests
// Iterative algorithms built with the loop constructs from examples/loops

// ─────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────

export fn factorial(n: i32): i64 {
    let result: i64 = 1;
    let i = 2;
    while (i <= n) {
        result = result * i;
        i = i + 1;
    }
    return result;
}

export fn fibonacci(n: i32): i64 {
    let a: i64 = 0;
    let b: i64 = 1;
    let i = 0;
    while (i < n) {
        let next = a + b;
        a = b;
        b = next;
        i = i + 1;
    }
    return a;
}

export fn sum_of_squares(n: i32): i32 {
    let total = 0;
    let k = 1;
    while (k <= n) {
        total = total + (k * k);
        k = k + 1;
    }
    return total;
}

export fn reversed(values: [int]) {
    let out = [];
    let i = values.len() - 1;
    while (i >= 0) {
        out.push(values[i]);
        i = i - 1;
    }
    return out;
}

export fn linear_search(values: [int], target: i32): i32 {
    let index = -1;
    let i = 0;
    while (i < values.len()) {
        if (values[i] == target) {
            index = i + 0;
            break;
        }
        i = i + 1;
    }
    return index;
}

export fn count_even(values: [int]): i32 {
    let count = 0;
    for (v in values) {
        if (v % 2 == 0) {
            count = count + 1;
        }
    }
    return count;
}

export fn gcd(a: i32, b: i32): i32 {
    let x = a;
    let y = b;
    while (y != 0) {
        let r = x % y;
        x = y;
        y = r;
    }
    return x;
}

export fn power(base: i32, exponent: i32): i32 {
    let result = 1;
    let i = 0;
    while (i < exponent) {
        result = result * base;
        i = i + 1;
    }
    return result;
}

// ─────────────────────────────────────────────────────────────
// Test Cases
// ─────────────────────────────────────────────────────────────

export test fn test_factorial_iterative() {
    assert_eq(factorial(0), 1);
    assert_eq(factorial(5), 120);
    assert_eq(factorial(10), 3628800);
}

export test fn test_fibonacci_iterative() {
    assert_eq(fibonacci(0), 0);
    assert_eq(fibonacci(1), 1);
    assert_eq(fibonacci(10), 55);
    assert_eq(fibonacci(20), 6765);
}

export test fn test_sum_of_squares() {
    assert_eq(sum_of_squares(3), 14);
    assert_eq(sum_of_squares(10), 385);
}

export test fn test_reverse_array() {
    let out = reversed([1, 2, 3]);
    assert_eq(out.len(), 3);
    assert_eq(out[0], 3);
    assert_eq(out[2], 1);
}

export test fn test_linear_search() {
    assert_eq(linear_search([4, 8, 15, 16, 23, 42], 15), 2);
    assert_eq(linear_search([4, 8, 15], 99), -1);
}

export test fn test_count_even() {
    assert_eq(count_even([1, 2, 3, 4, 5, 6]), 3);
    assert_eq(count_even([1, 3, 5]), 0);
}

export test fn test_gcd() {
    assert_eq(gcd(54, 24), 6);
    assert_eq(gcd(17, 5), 1);
    assert_eq(gcd(0, 7), 7);
}

export test fn test_power_iterative() {
    assert_eq(power(2, 10), 1024);
    assert_eq(power(5, 0), 1);
    assert_eq(power(-2, 3), -8);
}

// ─────────────────────────────────────────────────────────────
// Programmatic test suite runner for main.adesh integration
// ─────────────────────────────────────────────────────────────

export fn run_tests() {
    test_factorial_iterative();
    test_fibonacci_iterative();
    test_sum_of_squares();
    test_reverse_array();
    test_linear_search();
    test_count_even();
    test_gcd();
    test_power_iterative();
    return 8;
}

fn main() {
    print("Running 02_loop_algorithms tests...");
    let count = run_tests();
    print(`Passed ${count} tests in 02_loop_algorithms.test.adesh`);
}
