print("FOR ARRAY");
for (n in [10, 20, 30]) { print(n); }

print("JUMP IN ARRAY FOR");
for (v in [0, 1, 2, 3, 4, 5]) {
  if (v == 1) { jump 4; }
  print(v);
}

print("WHILE (cond)");
let a = 0;
while (a < 3) { print(a); a = a + 1; }

print("WHILE cond");
let b = 3;
while b>0 { print(b); b = b - 1; }

print("DO-WHILE");
let c = 0;
do { print(c); c = c + 1; } while (c < 2);

print("BREAK/CONTINUE");
let x = 1;
while (x <= 6) {
  if (x == 2) { x = x + 1; continue; }
  if (x == 5) { break; }
  print(x);
  x = x + 1;
}

print("DESC WHILE");
let d = 5;
while (d >= 1) { print(d); d = d - 1; }

print("WHILE TRUE BREAK");
let k = 0;
while (true) { if (k >= 3) { break; } print(k); k = k + 1; }

print("DO-WHILE BREAK");
let c2 = 0;
do { print(c2); if (c2 == 1) { break; } c2 = c2 + 1; } while (c2 < 5);

print("BIGINT WHILE");
let bi = 1n;
let bn = 3n;
while (bi <= bn) { print(bi); bi = bi + 1n; }
