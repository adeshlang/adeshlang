enum Direction {
    North,
    South,
    East,
    West
}

extend DirectionTest on Direction {
    fn opposite():String {
        return match this.tag {
            "North" => "returns North matched",
            "South" => "returns South matched",
            "East"  => "returns East matched",
            "West"  => "returns West matched"
        };
    }
}

let d = Direction.North();
print("tag:", d.tag);
let result = d.opposite();
print("result:", result);
