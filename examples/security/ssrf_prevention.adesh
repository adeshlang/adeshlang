// 7. Security Checklist
// -----------------------------------------------------------------------------

print("--- SSRF Prevention Checklist ---\n");

print("✓ URL Validation:");
print("  • Parse and validate before any network call");
print("  • Never trust user-provided URLs directly");
print("");

print("✓ Protocol Restrictions:");
print("  • Allow only http/https");
print("  • Block file://, gopher://, dict://, etc.");
print("");

print("✓ Host Restrictions:");
print("  • Block localhost and 127.0.0.0/8");
print("  • Block private ranges (10.x, 172.16-31.x, 192.168.x)");
print("  • Block cloud metadata (169.254.169.254)");
print("");

print("✓ Domain Allowlist:");
print("  • Maintain explicit list of allowed domains");
print("  • Use wildcards carefully");
print("");

print("✓ Request Hardening:");
print("  • Set strict timeouts");
print("  • Validate redirect targets");
print("  • Log blocked requests for security monitoring");

print("");
print("=== Demo Complete ===");
