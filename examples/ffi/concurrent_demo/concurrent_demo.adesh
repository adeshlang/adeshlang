// Concurrent/Thread-Safe Demo Functions
// Demonstrates that AdeshLang FFI functions can be called safely from multiple threads
// The Arc<Mutex<FfiRegistry>> implementation ensures thread safety

export fn hash_simple(value: i64): i64 {
    let h: i64;
    h = value;
    h = h ^ (h >> 16);
    h = h * 0x85ebca6b;
    h = h ^ (h >> 13);
    h = h * 0xc2b2ae35;
    h = h ^ (h >> 16);
    return h;
}

export fn counter_increment(current: i64, step: i64): i64 {
    return current + step;
}

export fn compute_intensive(n: i64): i64 {
    let sum: i64;
    sum = 0;
    let i: i64;
    i = 0;
    
    while i < n {
        let j: i64;
        j = 0;
        while j < 1000 {
            sum = sum + (i * j) % 1000;
            j = j + 1;
        }
        i = i + 1;
    }
    
    return sum;
}

export fn process_batch(start: i64, count: i64): i64 {
    let result: i64;
    result = 0;
    let i: i64;
    i = 0;
    
    while i < count {
        let value: i64;
        value = start + i;
        result = result + hash_simple(value);
        i = i + 1;
    }
    
    return result;
}

export fn validate_range(value: i64, min: i64, max: i64): i64 {
    if value < min {
        return 0;
    }
    if value > max {
        return 0;
    }
    return 1;
}
