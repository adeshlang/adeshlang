// Example: Call C math functions from libm
// Demonstrates multiple FFI declarations and numeric types

extern "C" {
    fn sqrt(x: f64) -> f64;
    fn pow(base: f64, exp: f64) -> f64;
    fn sin(x: f64) -> f64;
    fn cos(x: f64) -> f64;
}

fn main() {
    print("Math Functions via FFI:\n");
    
    let num = 16.0;
    print("sqrt(16.0) = ");
    print(sqrt(num));
    print("\n");
    
    print("pow(2.0, 10.0) = ");
    print(pow(2.0, 10.0));
    print("\n");
    
    print("sin(3.14159) = ");
    print(sin(3.14159));
    print("\n");
    
    print("cos(0.0) = ");
    print(cos(0.0));
    print("\n");
}

// To run:
// adesh run math_functions.adesh
// On Unix: automatically links libm
// On Windows: adesh run math_functions.adesh -l msvcrt
