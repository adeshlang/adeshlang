// Two's-complement behavior of plain numbers: ~x == -(x + 1), and right
// shifts are arithmetic (sign-extending).

print("~0:            ", ~0);
print("~1:            ", ~1);
print("~255 & 255:    ", ~255 & 255);
print("arith >>:      ", (-1) >> 3);
print("arith >> -128: ", (-128) >> 2);
print("count 0xFF:    ", std.bit_count(255));
print("mask low 4:    ", std.bit_mask(4));
print("extract:       ", std.bit_extract(0xF0, 4, 4));
