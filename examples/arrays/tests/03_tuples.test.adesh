// Tuple Tests
// Exercises tuple creation, length, first/last, indexing, destructuring and
// tuple-returning helpers as demonstrated by examples/arrays/tuple_examples.adesh.

// ─────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────

export fn pair_sum(p): i32 {
    return p.0 + p.1;
}

export fn swap_pair(p) {
    return (p.1, p.0);
}

export fn triple_last(t): i32 {
    return t[2];
}

export fn min_max(v: [int]) {
    let lo = v[0];
    let hi = v[0];
    for (x in v) {
        if (x < lo) {
            lo = x + 0;
        }
        if (x > hi) {
            hi = x + 0;
        }
    }
    return (lo, hi);
}

export fn zip_pair(a: i32, b: i32) {
    return (a, b);
}

// ─────────────────────────────────────────────────────────────
// Test Cases
// ─────────────────────────────────────────────────────────────

export test fn test_tuple_len_first_last() {
    let t = (10, 20, 30);
    assert_eq(t.len(), 3);
    assert_eq(first(t), 10);
    assert_eq(last(t), 30);
    assert_eq(t[1], 20);
    assert_eq(t.0, 10);
}

export test fn test_tuple_indexing() {
    let t = (7, 8, 9);
    assert_eq(t.0, 7);
    assert_eq(t.1, 8);
    assert_eq(t[0], 7);
    assert_eq(t[2], 9);
    assert_eq(triple_last(t), 9);
}

export test fn test_tuple_destructuring() {
    let (x, y, z) = (1, 2, 3);
    assert_eq(x, 1);
    assert_eq(y, 2);
    assert_eq(z, 3);
    let (lo, hi) = (5, 9);
    assert_eq(lo, 5);
    assert_eq(hi, 9);
}

export test fn test_pair_sum() {
    assert_eq(pair_sum((3, 4)), 7);
    assert_eq(pair_sum((0, 0)), 0);
    assert_eq(pair_sum((-5, 5)), 0);
    assert_eq(pair_sum((10, -3)), 7);
}

export test fn test_swap_pair() {
    let s = swap_pair((1, 2));
    assert_eq(s.0, 2);
    assert_eq(s.1, 1);
    let s2 = swap_pair((0, 7));
    assert_eq(s2.0, 7);
    assert_eq(s2.1, 0);
}

export test fn test_string_and_bool_tuples() {
    let t = ("a", "b");
    assert_eq(first(t), "a");
    assert_eq(t.1, "b");
    assert_eq(t.len(), 2);
    let flags = (true, false);
    assert_eq(flags.0, true);
    assert_eq(flags.1, false);
}

export test fn test_min_max_pair() {
    let r = min_max([4, 1, 9, -2]);
    assert_eq(r.0, -2);
    assert_eq(r.1, 9);
    let single = min_max([7]);
    assert_eq(single.0, 7);
    assert_eq(single.1, 7);
    let z = zip_pair(3, 4);
    assert_eq(z.0 + z.1, 7);
}

// ─────────────────────────────────────────────────────────────
// Programmatic test suite runner for main.adesh integration
// ─────────────────────────────────────────────────────────────

export fn run_tests() {
    test_tuple_len_first_last();
    test_tuple_indexing();
    test_tuple_destructuring();
    test_pair_sum();
    test_swap_pair();
    test_string_and_bool_tuples();
    test_min_max_pair();
    return 7;
}

fn main() {
    print("Running 03_tuples tests...");
    let count = run_tests();
    print(`Passed ${count} tests in 03_tuples.test.adesh`);
}
